<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101800361" targetNamespace="http://www.bizagi.com/definitions/_2026101800361" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_9f3927f0-8fe1-4529-84d4-6900b1e7bdf6" name="Generar reporte">
    <documentation>El personal administrativo genera reportes y constancias de cumplimiento de horas de asesoria a partir de las citas, la asistencia y las bitacoras del periodo.</documentation>
    <laneSet id="Id_9061bcc0-bb97-4e56-9b79-927f155d5419">
      <lane id="Id_21717266-ca17-406d-a79d-be36304de4ed" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_bed4a6ef-55d5-4abc-8fb5-1cba5ba393ca" />
      </lane>
      <lane id="Id_81df2dd1-44a2-4a82-a8fa-eae04167e79a" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_18c7ed9a-e278-4385-9a77-0e79bf1ae1e7" />
      </lane>
      <lane id="Id_5ee8515c-8c5b-4b26-b02d-13573796202a" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_252f2367-053b-4d9d-b7f4-14322427ce37" />
      </lane>
      <lane id="Id_c53113c2-67dd-49b9-b95d-c42974371a6c" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_4634b671-0563-483f-87e7-35e37dc44df5" />
      </lane>
    </laneSet>
    <startEvent id="Id_bafd1e7f-70ed-4645-aaa9-7efc0c726127" name="Periodo de seguimiento">
      <documentation>Arranca cuando el personal administrativo necesita evidencia del servicio de asesorias, por ejemplo para evaluacion docente o acreditacion.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_17ba4972-fe35-409b-b73d-b8d0335fe1c8</outgoing>
    </startEvent>
    <task id="Id_79b4676d-f0e6-434e-bcac-5120bca8b98c" name="Elegir periodo y asesor o materia del reporte">
      <documentation>El personal administrativo define el rango de fechas y si el reporte es por asesor o por materia.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_17ba4972-fe35-409b-b73d-b8d0335fe1c8</incoming>
      <outgoing>Id_03e9f7a5-f2b6-493c-b169-ec7e6436c22a</outgoing>
    </task>
    <serviceTask id="Id_5c10c1a3-add4-4686-8413-4a4c2db1b242" name="Reunir citas, asistencia y bitacoras del periodo">
      <documentation>El sistema reune las citas realizadas, la asistencia registrada y las bitacoras del periodo y filtro elegidos.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_03e9f7a5-f2b6-493c-b169-ec7e6436c22a</incoming>
      <outgoing>Id_b8101d1b-4840-438c-a93e-569055278e84</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_9934abfd-301a-4d60-b8d4-ceb094afb03a" name="Hay datos en el periodo seleccionado?" gatewayDirection="Diverging" default="Id_322b66cf-7242-419e-9c19-350fcb4da378">
      <documentation>Decision automatica: sin citas ni asistencia en el periodo no hay nada que reportar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b8101d1b-4840-438c-a93e-569055278e84</incoming>
      <outgoing>Id_322b66cf-7242-419e-9c19-350fcb4da378</outgoing>
      <outgoing>Id_9bba6e34-2d59-43a6-a1c6-ca60bf183a5b</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_db3a9999-26a2-400e-ace4-4e7ee45cf70f" name="Reporte no generado por falta de datos">
      <documentation>Cierre cuando el periodo no tiene informacion; el sistema avisa que no hay datos.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_322b66cf-7242-419e-9c19-350fcb4da378</incoming>
    </endEvent>
    <serviceTask id="Id_85606006-4631-4496-8bed-c1858e47d310" name="Calcular metricas: demanda, horas, % asistencia">
      <documentation>El sistema calcula la demanda por materia, las horas impartidas y el porcentaje de asistencia contra inasistencia.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_9bba6e34-2d59-43a6-a1c6-ca60bf183a5b</incoming>
      <outgoing>Id_bfc0b26b-0253-48ed-9411-219fb7f48bbe</outgoing>
    </serviceTask>
    <task id="Id_47f1c17c-8517-463c-8213-9a41806153de" name="Consultar dashboard de metricas">
      <documentation>El personal administrativo revisa las metricas calculadas antes de emitir el documento.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_bfc0b26b-0253-48ed-9411-219fb7f48bbe</incoming>
      <outgoing>Id_987d7420-b6b6-4396-8011-cbd12d7791f7</outgoing>
    </task>
    <task id="Id_e51a4933-8f2e-4921-a4aa-dd431ea728f8" name="Emitir reportes y constancias de cumplimiento de horas">
      <documentation>El personal administrativo solicita el reporte o la constancia de cumplimiento de horas.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
