  <BPMNDiagram id="Diagram_71547e1a-11bc-479e-a536-ca8e8c54a2a3" xmlns="http://www.omg.org/spec/BPMN/20100524/DI">
    <BPMNPlane id="DiagramElement_a6f085b9-9607-4d57-8b77-15b842541aa9" bpmnElement="Id_272c0fe7-8b14-4f35-9d2a-8f4751bbb5c4">
