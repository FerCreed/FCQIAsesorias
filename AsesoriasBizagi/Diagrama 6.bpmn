        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_987d7420-b6b6-4396-8011-cbd12d7791f7</incoming>
      <outgoing>Id_e3096eb5-21ad-449a-8927-72d3e9948fbb</outgoing>
    </task>
    <serviceTask id="Id_fe51e350-977d-4f7e-b56a-858ffd70b770" name="Generar documento de reporte/constancia">
      <documentation>El sistema produce el archivo del reporte o de la constancia con los datos del periodo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_e3096eb5-21ad-449a-8927-72d3e9948fbb</incoming>
      <outgoing>Id_d7070f4d-317b-49e9-bd63-63fcb972c817</outgoing>
    </serviceTask>
    <endEvent id="Id_046e8030-7347-47c2-9b74-c2fead97bb8c" name="Reportes y constancias emitidos">
      <documentation>Cierre del proceso: el documento queda disponible para evaluacion docente y acreditacion.</documentation>
