<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101806009" targetNamespace="http://www.bizagi.com/definitions/_2026101806009" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_73393c0e-f7c5-4fcf-92ce-55d3cdcf4c5f" name="Asignar tutores a materias">
    <documentation>El personal administrativo decide que materias imparte cada tutor en el ciclo vigente. Solo las materias asignadas aparecen al alumno cuando busca asesoria.</documentation>
    <laneSet id="Id_f1174214-59ff-4535-bf3b-e90560c057f6">
      <lane id="Id_48eb829f-ead6-4143-b166-6c8716e9c1e2" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_5061f551-a9e8-4cc4-ac44-ff93f6d9176f" />
      </lane>
      <lane id="Id_275a566d-c4f6-4733-b6e7-ec8afce8432f" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_8bf44e21-1de6-4b10-8550-2c219b0cb9e8" />
      </lane>
      <lane id="Id_2a0cdfb4-38fd-49d6-8a6c-b9607b146b74" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_e63c0f84-ccc9-4b70-9cda-f5e21197267a" />
      </lane>
      <lane id="Id_70646a99-e7a8-4baf-bc30-1f7f050176ec" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_0c949d64-8147-4e47-b2d7-11a7f33b2cd9" />
      </lane>
    </laneSet>
    <startEvent id="Id_be4734a1-02a6-4b46-9377-00697e8aaa9c" name="Inicio de periodo (coordinacion)">
      <documentation>Arranca el flujo con el que el personal administrativo prepara la oferta de asesorias del ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_67037abd-85fe-4cff-b541-38c09bc40f19</outgoing>
    </startEvent>
    <task id="Id_bcd9125f-574c-461a-a83a-10ec81fabf0e" name="Abrir el panel de direccion y elegir un tutor">
      <documentation>El personal administrativo entra al panel de direccion y selecciona al tutor al que le asignara materias.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_67037abd-85fe-4cff-b541-38c09bc40f19</incoming>
      <outgoing>Id_c19ea950-0d18-4a44-a14c-449825dde406</outgoing>
    </task>
    <serviceTask id="Id_155cbad8-2f0f-42d9-8c4a-9f9e7ffebd00" name="Consultar tutores y sus materias del ciclo vigente">
      <documentation>El sistema obtiene la lista de tutores y las materias que cada uno tiene asignadas en el ciclo vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_c19ea950-0d18-4a44-a14c-449825dde406</incoming>
      <outgoing>Id_92c96ff5-9c01-4956-ab29-e28a8ad8193d</outgoing>
    </serviceTask>
    <task id="Id_f0217f80-57cb-4432-82e6-e3e9aafd6179" name="Asignar plantilla docente a las materias">
      <documentation>El personal administrativo marca o desmarca las materias que el tutor impartira y confirma la asignacion.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_92c96ff5-9c01-4956-ab29-e28a8ad8193d</incoming>
      <outgoing>Id_c0b582ff-4615-4e7e-9ad1-9065caa7d969</outgoing>
    </task>
    <serviceTask id="Id_c4cc595d-428d-4dc5-aa4e-cc0c0bd36953" name="Validar que las materias existan y esten activas">
      <documentation>El sistema comprueba que cada materia elegida exista en el catalogo y no este dada de baja.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_c0b582ff-4615-4e7e-9ad1-9065caa7d969</incoming>
      <outgoing>Id_bb3a3ca4-32d4-455a-9029-d37ef4152870</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_9b7354cb-fcda-463c-9c85-04182fb544bf" name="Materias validas?" gatewayDirection="Diverging" default="Id_ab128dc8-54c6-49fa-bc04-9810a6f0a6ad">
      <documentation>Decision automatica: toda materia de la lista debe existir y estar activa.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_bb3a3ca4-32d4-455a-9029-d37ef4152870</incoming>
      <outgoing>Id_ab128dc8-54c6-49fa-bc04-9810a6f0a6ad</outgoing>
      <outgoing>Id_b93b76df-ab68-4e98-a115-a1ff934a46f2</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_a3c4e698-1c67-48b7-8a4b-8f6816fc3e47" name="Asignacion rechazada por materia invalida">
      <documentation>Cierre cuando alguna materia no existe o esta dada de baja; el sistema informa cual.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_ab128dc8-54c6-49fa-bc04-9810a6f0a6ad</incoming>
    </endEvent>
    <serviceTask id="Id_25d956d1-580b-4389-a699-474802f1f0ac" name="Verificar asesorias registradas de las materias retiradas">
      <documentation>El sistema revisa si las materias que se quitan al tutor ya tienen asesorias registradas en el ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b93b76df-ab68-4e98-a115-a1ff934a46f2</incoming>
      <outgoing>Id_066a7c6b-5315-40e8-bb35-75d120e6b2aa</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_9a6c675f-d2e3-481f-bbb8-040d05b5472a" name="Hay materias retiradas con asesorias registradas?" gatewayDirection="Diverging" default="Id_28bba79b-bcf7-4528-a7df-ba6c0038afe4">
      <documentation>Decision automatica: no se puede quitar una materia que ya tiene asesorias en el ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_066a7c6b-5315-40e8-bb35-75d120e6b2aa</incoming>
      <outgoing>Id_7181e6b8-b37b-435f-a0c4-0db2de6b35c5</outgoing>
      <outgoing>Id_28bba79b-bcf7-4528-a7df-ba6c0038afe4</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_479a3da8-349d-489b-8a97-fc801097b248" name="Asignacion rechazada por asesorias registradas">
      <documentation>Cierre cuando se intenta retirar una materia con asesorias vigentes; el sistema muestra el motivo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_7181e6b8-b37b-435f-a0c4-0db2de6b35c5</incoming>
    </endEvent>
    <serviceTask id="Id_118a0f83-a4d7-47fe-a630-f5836de2314c" name="Guardar asignacion de materias">
      <documentation>El sistema registra las materias que quedaron asignadas al tutor en el ciclo vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_28bba79b-bcf7-4528-a7df-ba6c0038afe4</incoming>
      <outgoing>Id_5202a9e5-8beb-4fbf-8f38-1ee35e16bf77</outgoing>
    </serviceTask>
    <endEvent id="Id_0c35290b-7265-409a-8cf9-dca42ba9d698" name="Materias del tutor actualizadas">
      <documentation>Cierre del proceso: el catalogo del alumno ya usa la nueva lista de materias del tutor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
