      <outgoing>Id_02e4f6b4-6bb8-4c60-9740-2d4028eecdf5</outgoing>
    </serviceTask>
    <task id="Id_18e9ecd3-ff90-4b66-8898-c20a5c4a99f2" name="Registrar bitacora rapida (notas de avance del estudiante)">
      <documentation>El asesor escribe una nota breve sobre el avance o los temas vistos con el alumno.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
