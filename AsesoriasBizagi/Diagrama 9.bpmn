<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101804555" targetNamespace="http://www.bizagi.com/definitions/_2026101804555" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_703f17cd-c2c2-4cd5-9712-a28e56b28a4e" name="Registrar bitacora">
    <documentation>Despues de impartir una asesoria, el asesor marca la asistencia y deja una nota breve del avance del alumno; el sistema guarda ambos datos y marca la cita como realizada.</documentation>
    <laneSet id="Id_2a08180d-a0f2-4e4e-8ef7-f3cffcbe1240">
      <lane id="Id_bb1768be-9a8b-47eb-a704-62d227de5eb8" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_6bf6f1f8-2411-4119-a1bd-37da00b4d0eb" />
      </lane>
      <lane id="Id_aad99e64-5e57-4809-962d-b50655bbc7cf" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_7cb802ca-284c-47e5-97a0-53837a9b0229" />
      </lane>
      <lane id="Id_40fe27bf-ea72-4e29-b654-c3fbc1a24cc1" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_d3ceded8-5c11-42e9-9544-fc8f11f096be" />
      </lane>
      <lane id="Id_476ae559-d250-4d8d-8973-3eb155639bde" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_f5a236e9-b76f-4298-a48b-26fc8bbd9153" />
      </lane>
    </laneSet>
    <startEvent id="Id_4e4106fa-3115-41a3-8316-18eac2a1cce9" name="Sesion de asesoria concluida">
      <documentation>Arranca cuando el asesor termina de impartir una asesoria confirmada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_985c4382-0539-4fbb-a024-786ac9c105d8</outgoing>
    </startEvent>
    <task id="Id_283a36e2-0202-4630-86a9-908b96b48097" name="Abrir la cita impartida">
      <documentation>El asesor abre la cita que acaba de atender desde su agenda.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_985c4382-0539-4fbb-a024-786ac9c105d8</incoming>
      <outgoing>Id_20542a87-bd4a-4ee2-aa44-6db1ae9c86fe</outgoing>
    </task>
    <serviceTask id="Id_b6991afd-aab2-4d4a-8141-e2318ebb39c2" name="Validar que la cita sea del asesor y este confirmada">
      <documentation>El sistema comprueba que la cita pertenezca al asesor y que su estado sea Confirmada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_20542a87-bd4a-4ee2-aa44-6db1ae9c86fe</incoming>
      <outgoing>Id_5641a66c-574d-433a-9672-06a25540e292</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_3bbf3b87-c572-4eb9-a48d-f4619f65b23c" name="Cita valida para registrar bitacora?" gatewayDirection="Diverging" default="Id_1f23600e-34c2-48d6-8d32-717722943197">
      <documentation>Decision automatica sobre la propiedad y el estado de la cita.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_5641a66c-574d-433a-9672-06a25540e292</incoming>
      <outgoing>Id_1f23600e-34c2-48d6-8d32-717722943197</outgoing>
      <outgoing>Id_a67971d5-aa3a-42d3-a033-228d0f6ffc84</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_20c30d33-c533-4901-8cc8-e3b871dc7945" name="Registro de bitacora rechazado">
      <documentation>Cierre cuando la cita no es del asesor o no esta confirmada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
