        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_1f23600e-34c2-48d6-8d32-717722943197</incoming>
    </endEvent>
    <task id="Id_5e63e854-5133-4780-a566-72ba0586ae99" name="Marcar asistencia del alumno (pase de lista)">
      <documentation>El asesor indica con un clic si el alumno asistio o no.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a67971d5-aa3a-42d3-a033-228d0f6ffc84</incoming>
      <outgoing>Id_ac4f8c0b-482a-4197-9c13-a1891d895782</outgoing>
    </task>
    <serviceTask id="Id_b27cc2a4-a544-4f4e-8c16-e14985ab2232" name="Registrar asistencia en el sistema">
      <documentation>El sistema guarda el pase de lista de la cita.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
