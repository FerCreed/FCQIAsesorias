      <outgoing>Id_eb06ba98-a7d3-48b5-880c-ab72d348a1f6</outgoing>
    </task>
    <serviceTask id="Id_8e864747-7360-4e92-9c80-27eacd11292d" name="Guardar bitacora en el sistema">
      <documentation>El sistema almacena la nota y la deja disponible para los reportes del personal administrativo.</documentation>
