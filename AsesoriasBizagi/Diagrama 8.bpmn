            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_ff38e1cd-5426-40b5-81d5-a9355b75b7a5</incoming>
      <outgoing>Id_fbb089e1-2332-42a6-a19a-ed212154d200</outgoing>
      <outgoing>Id_3300fb8d-fe47-43f9-bb8d-c491715de37d</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_4af2de40-80ae-46d0-b8fb-93838ec9e003" name="Solicitud rechazada por el sistema">
      <documentation>Cierre cuando alguna validacion falla; el sistema muestra el motivo al alumno.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_fbb089e1-2332-42a6-a19a-ed212154d200</incoming>
    </endEvent>
    <exclusiveGateway id="Id_94a871c7-bf57-4810-bb07-259367970682" name="Existe cupo disponible en el horario seleccionado?" gatewayDirection="Diverging" default="Id_79e42254-061b-4de9-b033-21cd5d25caab">
      <documentation>Decision automatica: compara las asesorias activas de ese bloque y fecha contra su cupo maximo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
