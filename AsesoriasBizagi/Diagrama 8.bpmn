    <task id="Id_266a0803-3c24-48db-8fb5-c9d1d9789470" name="Recibir confirmacion automatica">
      <documentation>El alumno recibe el aviso de que su solicitud quedo registrada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
