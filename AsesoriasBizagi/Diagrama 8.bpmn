      <outgoing>Id_b24c4703-d8ce-4d19-b238-ccb203be4af7</outgoing>
    </task>
    <task id="Id_c13e3838-e4fd-44de-9483-1aa9a19f8144" name="Recibir notificacion de nueva cita">
      <documentation>El asesor es avisado de que un alumno solicito un horario con el.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
