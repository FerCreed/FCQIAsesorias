<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101800968" targetNamespace="http://www.bizagi.com/definitions/_2026101800968" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_114aebd7-6f70-409e-be50-57410b870b15" name="Reservar asesoria">
    <documentation>El alumno busca, elige un horario y registra el tema de su asesoria; el sistema valida la solicitud y el cupo, registra la reserva y avisa al alumno y al asesor.</documentation>
    <laneSet id="Id_cfd6f7cc-f691-4558-acda-0665be5d854d">
      <lane id="Id_0b9cab78-f9fe-42cc-8f26-fc7f02246755" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_58b40711-8146-4288-8fa2-704e2b2f1971" />
      </lane>
      <lane id="Id_3e361e2a-edb9-4641-9376-4b377b97990a" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_4960dbcd-9e64-4e47-b75c-43644bae1fd3" />
      </lane>
      <lane id="Id_9d4baec5-5b4e-4f3c-8696-dc3d4e08215b" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_3d93ee03-eab2-4744-8201-d6b6ce3a7b9e" />
      </lane>
      <lane id="Id_401250d9-6eb1-4d46-abba-3434cdb9da42" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_0ceabfdb-2156-4c6f-b6ef-d0a43e1dfb7c" />
      </lane>
    </laneSet>
    <startEvent id="Id_9e8a8081-9239-4b02-81a0-ace63b35c51c" name="Alumno necesita agendar una asesoria">
      <documentation>Arranca cuando un alumno con sesion iniciada quiere pedir una asesoria.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_4243c941-9dbc-4b88-997e-cbb0f8c638b0</outgoing>
    </startEvent>
    <task id="Id_cbd4c533-d37a-4a4d-b06d-ad4989482d8a" name="Buscar y filtrar asesorias (materia, programa, profesor, modalidad, dia/horario)">
      <documentation>El alumno usa los filtros del buscador para encontrar tutores y horarios que le sirvan.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_4243c941-9dbc-4b88-997e-cbb0f8c638b0</incoming>
      <incoming>Id_60e7a244-7807-4e9a-9510-dcb0a2e9cc1f</incoming>
      <outgoing>Id_6c960e2a-5665-439b-8174-403ed6583e1e</outgoing>
    </task>
    <serviceTask id="Id_990ecfab-3266-40e5-b505-9676c4f23cc9" name="Consultar asesorias y tutores disponibles">
      <documentation>El sistema cruza los filtros del alumno con los tutores y horarios registrados y devuelve los resultados.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_6c960e2a-5665-439b-8174-403ed6583e1e</incoming>
      <outgoing>Id_c994f63c-228f-4ebe-94b5-d7174b39f1b7</outgoing>
    </serviceTask>
    <task id="Id_d34fabf4-d349-4cb8-bc8f-4d6c4f6c32ba" name="Seleccionar horario disponible y registrar tema/dudas">
      <documentation>El alumno elige un bloque de horario y escribe el tema o las dudas que quiere tratar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_c994f63c-228f-4ebe-94b5-d7174b39f1b7</incoming>
      <outgoing>Id_3b9a4f8f-b6c6-4268-ad86-ffba7f27aa6e</outgoing>
    </task>
    <serviceTask id="Id_2ca9dec0-b093-4c45-b436-6a525561ea84" name="Validar solicitud (tutor imparte la materia, horario del tutor, fecha y hora del bloque)">
      <documentation>El sistema comprueba que el alumno este activo, que el tutor tenga la materia asignada, que el horario sea suyo, que la fecha y hora correspondan al bloque y que no sea en el pasado ni se duplique.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3b9a4f8f-b6c6-4268-ad86-ffba7f27aa6e</incoming>
      <outgoing>Id_ff38e1cd-5426-40b5-81d5-a9355b75b7a5</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_3c1e0358-e8ca-4065-9660-c1ded29a626c" name="Solicitud valida?" gatewayDirection="Diverging" default="Id_fbb089e1-2332-42a6-a19a-ed212154d200">
      <documentation>Decision automatica sobre el resultado de las validaciones.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
