    <endEvent id="Id_8008b986-3e45-4314-abc3-f3d0479757cd" name="Solicitud registrada">
      <documentation>Cierre del lado del alumno: su solicitud queda pendiente de que el asesor la atienda.</documentation>
      <extensionElements>
