      <outgoing>Id_277a55d8-35ea-4ef6-8ae6-e2c0464d02e4</outgoing>
    </exclusiveGateway>
    <serviceTask id="Id_010714e1-68b4-40d4-8ee4-1caf87b53b05" name="Mostrar horario sin cupo">
      <documentation>El sistema informa que ese horario ya esta lleno y regresa al alumno al buscador para intentar con otro.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
