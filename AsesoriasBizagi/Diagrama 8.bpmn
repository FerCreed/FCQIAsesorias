    <parallelGateway id="Id_7f4848a8-1b2a-45d0-945a-520b9b68ea53" name="Notificar reserva" gatewayDirection="Diverging">
      <documentation>Tras registrar la reserva, el sistema avisa en paralelo al alumno y al asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
