<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101803160" targetNamespace="http://www.bizagi.com/definitions/_2026101803160" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_62258d0c-1b81-46e1-a780-7f4e417aa188" name="Salir sesion">
    <documentation>La persona cierra su sesion. El cliente borra el token y los datos en pantalla y regresa al acceso. El servidor no participa: el token sigue siendo valido hasta que vence.</documentation>
    <laneSet id="Id_79049009-eebf-4340-8b5f-1f26bdf23b84">
      <lane id="Id_e8ac6cd9-0114-40fd-92fe-306024cf614a" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_cf3b7c70-2463-4941-a2ca-c0268132b4ff" />
      </lane>
      <lane id="Id_e15e8362-3f4a-48d2-a5e6-e7f77d51ccd3" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_f8ad5e37-fff6-4935-871e-bb690ff054bc" />
      </lane>
      <lane id="Id_b03ebbc9-260e-4391-abbf-63d9731553d6" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_e27239ec-bfe3-4560-a8ec-7367dcab89ba" />
      </lane>
      <lane id="Id_1abb0f2b-044f-4d9e-b7d9-ce37f443ab47" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_08f2524e-8e55-41ff-b26b-2baa5165a466" />
      </lane>
    </laneSet>
    <startEvent id="Id_f27ec0f3-4771-4f79-b81b-805239cc7239" name="Necesita cerrar sesion">
      <documentation>Arranca cuando la persona termina de usar el sistema.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_c56e58c5-2a3c-4a90-8e51-0be19f4dd713</outgoing>
    </startEvent>
    <task id="Id_205846b9-e8d9-4822-ac4c-c1ec6090465a" name="Elegir Salir en el menu">
      <documentation>La persona pulsa el boton Salir del encabezado.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_c56e58c5-2a3c-4a90-8e51-0be19f4dd713</incoming>
      <outgoing>Id_90401cec-02eb-4f1c-ba0b-1cf2c946dcab</outgoing>
    </task>
    <serviceTask id="Id_bb7c8528-08d4-4e93-ad3a-32afc4f5eff8" name="Borrar el token y los datos de la sesion en el cliente">
      <documentation>La aplicacion elimina el token, los roles y la identidad guardados en el navegador.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_90401cec-02eb-4f1c-ba0b-1cf2c946dcab</incoming>
      <outgoing>Id_dca372bc-85e0-46ca-a123-6180300ab84d</outgoing>
    </serviceTask>
    <serviceTask id="Id_4aadd337-9420-48d4-8585-9cc6cac3a9da" name="Limpiar listas y selecciones en pantalla">
      <documentation>La aplicacion vacia materias, tutores, horarios y asesorias para que la siguiente persona no vea datos ajenos.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_dca372bc-85e0-46ca-a123-6180300ab84d</incoming>
      <outgoing>Id_367e5118-b831-4cf9-841f-8cc4a322e9e7</outgoing>
    </serviceTask>
    <serviceTask id="Id_5fb0c46d-e3f5-4143-8986-9c107da0586a" name="Regresar a la pantalla de acceso">
      <documentation>La aplicacion muestra de nuevo el acceso institucional.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_367e5118-b831-4cf9-841f-8cc4a322e9e7</incoming>
      <outgoing>Id_8274f747-44e6-4b6d-8326-dd014feef113</outgoing>
    </serviceTask>
    <endEvent id="Id_0be4bb0b-8c4f-4443-809d-1050894be766" name="Sesion cerrada">
      <documentation>Cierre del proceso.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
