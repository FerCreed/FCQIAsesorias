<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101804954" targetNamespace="http://www.bizagi.com/definitions/_2026101804954" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_d647de1f-753d-4ba4-97f4-6fab94eb84e6" name="Rechazar asesoria">
    <documentation>El asesor revisa una solicitud pendiente y la rechaza. El sistema valida que sea suya y siga pendiente, la pasa a Rechazada, libera el lugar, deja el historial y avisa al alumno.</documentation>
    <laneSet id="Id_459d1471-4c8f-4543-8286-c3c51e322b97">
      <lane id="Id_dceda3b3-d347-4de0-885c-800e211bc7a2" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_e0ce5f0b-be2a-4745-9f05-e38e9eef9017" />
      </lane>
      <lane id="Id_7ae6263e-8620-4d3b-ba20-b148e89793e0" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_3a6f95f9-49e8-436d-b8ea-b1494739b058" />
      </lane>
      <lane id="Id_8bedaee2-0dba-4db3-a99a-1fb55cc02757" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_a30b32c2-d084-4015-9b87-1ca150291674" />
      </lane>
      <lane id="Id_5debb883-e7a3-4b4d-8a4d-30dc0137829b" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_3dabc558-920e-4670-8d04-1a9e9c0d60c2" />
      </lane>
    </laneSet>
    <startEvent id="Id_1f122d26-5bcf-4a22-84d6-9d105fc08616" name="Nueva solicitud pendiente">
      <documentation>Arranca cuando un alumno solicita una asesoria y la solicitud queda pendiente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_34cfa966-d1dd-42ed-a7f2-9fcef87926b0</outgoing>
    </startEvent>
    <task id="Id_e82a7461-2030-46d7-b028-4db7e6e09b15" name="Consultar bandeja de solicitudes">
      <documentation>El asesor abre su bandeja de solicitudes.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_34cfa966-d1dd-42ed-a7f2-9fcef87926b0</incoming>
      <outgoing>Id_8d687a32-d6dd-4de1-bf83-ad6b3a672418</outgoing>
    </task>
    <serviceTask id="Id_9c1f68fb-8f3d-43ae-b39e-4efbd01dab1d" name="Consultar solicitudes pendientes del asesor">
      <documentation>El sistema devuelve las asesorias que le tocan a ese asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_8d687a32-d6dd-4de1-bf83-ad6b3a672418</incoming>
      <outgoing>Id_8ef2b720-7332-44fb-9eee-2d6932806cbc</outgoing>
    </serviceTask>
    <task id="Id_28e2eec7-a447-4364-bd03-2d3205cf948d" name="Revisar solicitud">
      <documentation>El asesor revisa materia, alumno, fecha y tema.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_8ef2b720-7332-44fb-9eee-2d6932806cbc</incoming>
      <outgoing>Id_a6e3d91a-430a-47e3-bdf8-0398733fef2f</outgoing>
    </task>
    <exclusiveGateway id="Id_bb362fc0-7a75-4eca-bf8c-f3d6fe39af90" name="El asesor rechaza la solicitud?" gatewayDirection="Diverging" default="Id_c73ac0ba-74f9-456b-a7a8-436f02b26cdc">
      <documentation>Decision humana del asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
