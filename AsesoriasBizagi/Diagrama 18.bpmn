            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_82075149-d62f-4dd3-88f6-210a0072a81e</incoming>
      <outgoing>Id_f1f99803-5adb-41bb-b784-fcca1c78c4cb</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_6d28305a-fe1d-4694-a343-0231201af0df" name="Solicitud valida para rechazar?" gatewayDirection="Diverging" default="Id_0dc16b8b-6575-4df9-b5fe-f2ee127f2edb">
