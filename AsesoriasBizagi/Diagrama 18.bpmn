      <outgoing>Id_3f4805f7-993e-4661-acb6-955bb8de1ea1</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_5d59b7ac-059a-47a4-a7c1-06b6f4451067" name="Solicitud conservada como pendiente">
      <documentation>Cierre cuando el asesor no la rechaza; puede aceptarla en el proceso Aceptar cita de asesoria.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_c73ac0ba-74f9-456b-a7a8-436f02b26cdc</incoming>
    </endEvent>
    <task id="Id_a7fb4ef6-1250-4f48-a34d-30d0a383ff01" name="Rechazar asesoria">
      <documentation>El asesor pulsa el boton Rechazar sobre la solicitud.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3f4805f7-993e-4661-acb6-955bb8de1ea1</incoming>
      <outgoing>Id_82075149-d62f-4dd3-88f6-210a0072a81e</outgoing>
    </task>
    <serviceTask id="Id_38d38653-e962-45f4-90dc-05885e64c8d3" name="Validar que la solicitud sea del asesor y siga pendiente">
      <documentation>El sistema comprueba que la solicitud pertenezca al asesor y no este cancelada o rechazada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
