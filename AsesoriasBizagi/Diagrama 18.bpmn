    <serviceTask id="Id_3462a176-ce28-4418-a054-45848b7aeca4" name="Actualizar estado a Rechazada y liberar el cupo">
      <documentation>El sistema cambia la solicitud a Rechazada; al dejar de estar activa libera el lugar del horario.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
