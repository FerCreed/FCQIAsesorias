      <incoming>Id_c723f9f6-29e9-4cc1-bb5d-28ce8c07a94f</incoming>
      <outgoing>Id_e236d3c2-e471-48a9-b22a-6198747fa3b2</outgoing>
    </task>
    <task id="Id_20056360-2f75-4b88-8768-440f3d6a7831" name="Recibir enlace de Meet de la asesoria">
