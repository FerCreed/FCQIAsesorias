<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101806407" targetNamespace="http://www.bizagi.com/definitions/_2026101806407" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_541d24b0-1fc3-4372-901e-220a09f58879" name="Crear enlace de Meet">
    <documentation>Cuando una cita virtual se confirma, el sistema genera el enlace de Meet, lo guarda en la cita y lo comparte con el alumno y el asesor.</documentation>
    <laneSet id="Id_86557fcd-f1d1-4df8-abd1-f259c5dc61cd">
      <lane id="Id_d4c7d71a-6ec3-4a0f-bb6c-1431f53230c8" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_566e0a67-8e82-4ca7-a696-12bc1c6c4dbb" />
      </lane>
      <lane id="Id_9ec547a1-3fb0-4027-83a7-f1e5b690944d" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_232210e9-385e-4d63-b5b3-551e0dc000f9" />
      </lane>
      <lane id="Id_fc7d55cd-8d5d-4097-92ed-ee35c47a4161" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_76f293dc-b04b-4819-ab8c-65c7e0fe018d" />
      </lane>
      <lane id="Id_fe80a8fa-91e0-4caf-98a1-04f9f21477b2" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_1d904733-74b7-43c2-9ab2-58091c10e30f" />
      </lane>
    </laneSet>
    <startEvent id="Id_3c0641ae-8ac1-4d27-b775-45015c492f58" name="Cita confirmada por el asesor">
      <documentation>Arranca cuando el asesor confirma una cita.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_15b15fc9-09a8-4ca0-b908-3f6769eaabab</outgoing>
    </startEvent>
    <serviceTask id="Id_061b72ed-ffac-45a1-a006-de5bfda63f8b" name="Revisar la modalidad de la cita">
      <documentation>El sistema consulta la modalidad del lugar de la cita: presencial o virtual.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_15b15fc9-09a8-4ca0-b908-3f6769eaabab</incoming>
      <outgoing>Id_b1f5cc7a-b3b7-4591-bdd8-49e3a94d3ec1</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_237bc341-4740-47d8-b863-c2ae091873af" name="La modalidad es virtual?" gatewayDirection="Diverging" default="Id_d349689c-9298-4f4c-a5f3-7934ea8bad39">
      <documentation>Decision automatica: solo las citas virtuales necesitan enlace.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b1f5cc7a-b3b7-4591-bdd8-49e3a94d3ec1</incoming>
      <outgoing>Id_d349689c-9298-4f4c-a5f3-7934ea8bad39</outgoing>
      <outgoing>Id_a942dd7a-4070-47c3-b10c-28dfc79fc0d6</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_fcd6f01b-bf0e-4283-b854-d2000011231c" name="Cita presencial sin enlace">
      <documentation>Cierre cuando la cita es presencial; no se crea ningun enlace.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d349689c-9298-4f4c-a5f3-7934ea8bad39</incoming>
    </endEvent>
    <serviceTask id="Id_86a9713c-10de-4b42-beb4-3a6ccd5a0323" name="Generar enlace de Meet via API">
      <documentation>El sistema solicita al servicio de Google Meet un enlace para la fecha y hora de la cita.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a942dd7a-4070-47c3-b10c-28dfc79fc0d6</incoming>
      <outgoing>Id_74579aba-a684-4269-99b2-f693d03babbe</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_5f4b0dc0-e1ee-4fd0-9b22-3c6403fc4733" name="Enlace generado correctamente?" gatewayDirection="Diverging" default="Id_c4d461c5-30e3-4b37-9748-b1cb51c56014">
      <documentation>Decision automatica sobre la respuesta del servicio externo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_74579aba-a684-4269-99b2-f693d03babbe</incoming>
      <outgoing>Id_c4d461c5-30e3-4b37-9748-b1cb51c56014</outgoing>
      <outgoing>Id_4985820a-91e5-4396-b33a-e411b86e7cc1</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_4ba1eda9-fd24-4961-bbdb-fe9182e50769" name="Error al generar el enlace">
      <documentation>Cierre cuando el servicio no responde o rechaza la solicitud; se informa al asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_c4d461c5-30e3-4b37-9748-b1cb51c56014</incoming>
    </endEvent>
    <serviceTask id="Id_a9224bbd-ac03-45ad-8abc-79241a428f67" name="Guardar enlace en la cita">
      <documentation>El sistema almacena el enlace dentro del registro de la cita.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_4985820a-91e5-4396-b33a-e411b86e7cc1</incoming>
      <outgoing>Id_52845fc1-117d-4d7d-bc96-3c63c84a9061</outgoing>
    </serviceTask>
    <parallelGateway id="Id_3275ec19-6f9e-46a0-8551-66899c6b81d6" name="Enviar enlace" gatewayDirection="Diverging">
      <documentation>El sistema comparte el enlace en paralelo con el alumno y con el asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
