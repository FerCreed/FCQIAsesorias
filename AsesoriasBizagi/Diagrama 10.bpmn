      </extensionElements>
      <incoming>Id_52845fc1-117d-4d7d-bc96-3c63c84a9061</incoming>
      <outgoing>Id_c723f9f6-29e9-4cc1-bb5d-28ce8c07a94f</outgoing>
      <outgoing>Id_91ef9f01-d985-4a21-b37a-cc18e69f1e27</outgoing>
    </parallelGateway>
    <task id="Id_40497a7c-d249-4c1e-97ec-ed306a6e6082" name="Recibir enlace de Meet de la asesoria">
      <documentation>El alumno recibe el enlace para conectarse a la sesion.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
