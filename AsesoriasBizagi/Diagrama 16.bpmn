<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101800918" targetNamespace="http://www.bizagi.com/definitions/_2026101800918" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_dccf379e-235e-496a-8452-fa10d8f57ad3" name="Modificar horarios">
    <documentation>El asesor retira un bloque de horario. Si el bloque tiene citas activas no se retira; si no, el sistema lo da de baja para que deje de mostrarse a los alumnos.</documentation>
    <laneSet id="Id_577f5e95-190b-42ed-bb66-b47b3a0d3563">
      <lane id="Id_1381acf8-0574-47d7-9f3c-b27fc53fbdc0" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_340a868c-2791-4d64-8b22-60c8fa20b1d3" />
      </lane>
      <lane id="Id_866343c3-b6bd-43d9-aec4-681593c5a10d" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_d482ce08-0ee3-420b-a0fa-f589442055de" />
      </lane>
      <lane id="Id_fb662e73-d417-41af-8492-14553a8a2100" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_04e1b48c-4400-4276-9cb0-e295c27b1c0c" />
      </lane>
      <lane id="Id_139b3b65-b352-4a62-8cae-97b112cc112e" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_0a7531b7-d238-4b26-bc94-938c5cbf3330" />
      </lane>
    </laneSet>
    <startEvent id="Id_5ceb9bcf-34fc-4122-95ea-d745822e61ae" name="Necesita retirar un bloque de horario">
      <documentation>Arranca cuando el asesor ya no puede atender en un bloque publicado.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_669ffb1c-7a04-48ca-9762-d6806fd77821</outgoing>
    </startEvent>
    <serviceTask id="Id_e8d52ce9-1dab-4dbe-bdf0-706ce3de0597" name="Consultar horarios activos del asesor">
      <documentation>El sistema devuelve los bloques activos del asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_669ffb1c-7a04-48ca-9762-d6806fd77821</incoming>
      <outgoing>Id_4be8d204-c4a1-47cc-9c00-144b327abd12</outgoing>
    </serviceTask>
    <task id="Id_f01adc76-5286-4e4a-b0ce-31536a3db587" name="Seleccionar el bloque a retirar">
      <documentation>El asesor elige el bloque que quiere dar de baja.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_4be8d204-c4a1-47cc-9c00-144b327abd12</incoming>
      <outgoing>Id_0b21ef46-038c-46c5-8789-e4b730461272</outgoing>
    </task>
    <serviceTask id="Id_43824699-bfd1-444d-b678-9bec13d9de63" name="Verificar citas activas del bloque">
      <documentation>El sistema busca citas pendientes o confirmadas asociadas al bloque.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_0b21ef46-038c-46c5-8789-e4b730461272</incoming>
      <outgoing>Id_69fdf897-08cc-4291-9fbd-f09ef7788516</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_6058bce2-58db-4e8a-89da-0fed5f48dcad" name="El bloque tiene citas activas?" gatewayDirection="Diverging" default="Id_73218ad1-5d26-4b66-96c2-ad3f1f06bbb7">
      <documentation>Decision automatica: un bloque con citas vigentes no puede retirarse.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_69fdf897-08cc-4291-9fbd-f09ef7788516</incoming>
      <outgoing>Id_2b5b39ee-a22e-4ec8-8464-aec798b5ba24</outgoing>
      <outgoing>Id_73218ad1-5d26-4b66-96c2-ad3f1f06bbb7</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_7897f4ae-d72c-4b1e-8478-20f1c0a55162" name="Retiro rechazado por citas activas">
      <documentation>Cierre cuando existen citas vigentes; el asesor debe atenderlas o cancelarlas antes.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_2b5b39ee-a22e-4ec8-8464-aec798b5ba24</incoming>
    </endEvent>
    <serviceTask id="Id_9e141101-d815-48be-b0af-851d65ad6ec6" name="Dar de baja el bloque de horario">
      <documentation>El sistema marca el bloque como inactivo; no se borra, para conservar el historial.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_73218ad1-5d26-4b66-96c2-ad3f1f06bbb7</incoming>
      <outgoing>Id_28263aba-c5d6-4ad7-92f3-174a91ce3237</outgoing>
    </serviceTask>
    <task id="Id_5578880d-364d-4ef0-bfc0-f57ad2a9aa8d" name="Recibir confirmacion del retiro">
      <documentation>El asesor ve que el bloque fue retirado.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_28263aba-c5d6-4ad7-92f3-174a91ce3237</incoming>
      <outgoing>Id_3bbd55e3-09cc-46b1-8bd1-e9382680c0b4</outgoing>
    </task>
    <endEvent id="Id_65fd5581-a3a0-4f6a-b383-2d75b26e72d6" name="Horario retirado">
      <documentation>Cierre del proceso: el bloque deja de mostrarse a los alumnos.</documentation>
