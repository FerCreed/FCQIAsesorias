<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101802894" targetNamespace="http://www.bizagi.com/definitions/_2026101802894" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_42b6efe2-8c42-4c0f-890e-77c8283f36d0" name="Consultar y elegir materias">
    <documentation>El alumno revisa el catalogo de materias activas y elige una; el sistema verifica que tenga tutores asignados.</documentation>
    <laneSet id="Id_09c98087-2ea3-4cb5-9352-99d873932202">
      <lane id="Id_6b7fa056-4d8b-41d1-9c9c-6f39f91c546e" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_ccaf32f7-f5f9-4f09-b1c5-63d12637b3af" />
      </lane>
      <lane id="Id_544ec581-6db3-4c3c-80b2-184b73b07100" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_6c5bcadd-0a93-478f-9684-23b48e9f7eab" />
      </lane>
      <lane id="Id_a7cd5770-eb62-4faf-8eea-eafe7abc4299" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_567b7f20-79f9-4d28-82ae-982643c78edd" />
      </lane>
      <lane id="Id_c521c2de-9b64-4686-84de-f19e29bdcff6" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_69f36bf9-e54f-4c7b-bd4d-94d0c287aa36" />
      </lane>
    </laneSet>
    <startEvent id="Id_24c49285-5fb6-4ec0-8aa9-5e310a7fc710" name="Necesita asesoria en una materia">
      <documentation>Arranca cuando el alumno quiere pedir ayuda academica en una materia.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_9237cb36-d8e2-4c02-9266-b3fd670ff5c8</outgoing>
    </startEvent>
    <task id="Id_10a50bcf-0f77-44a3-ab68-e37473699c2a" name="Abrir el buscador de asesorias">
      <documentation>El alumno entra a la pantalla de busqueda de asesorias.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_9237cb36-d8e2-4c02-9266-b3fd670ff5c8</incoming>
      <outgoing>Id_58129702-54f6-4714-88e9-a1b2604cdea2</outgoing>
    </task>
    <serviceTask id="Id_c047d3ea-37d0-4610-900f-62d429986482" name="Consultar catalogo de materias activas">
      <documentation>El sistema carga las materias activas del catalogo del ciclo vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_58129702-54f6-4714-88e9-a1b2604cdea2</incoming>
      <outgoing>Id_a015c381-b9dc-4429-b2fc-0b929b901fdc</outgoing>
    </serviceTask>
    <task id="Id_7da1c277-cfa2-4e89-844c-8b32da866ee1" name="Revisar catalogo de materias">
      <documentation>El alumno revisa la lista de materias disponibles.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a015c381-b9dc-4429-b2fc-0b929b901fdc</incoming>
      <outgoing>Id_d7c8b81c-7416-4a13-b250-481326ea13a1</outgoing>
    </task>
    <task id="Id_1ca6dd85-1824-4b91-87a6-7818a7a85a69" name="Elegir materia">
      <documentation>El alumno selecciona la materia en la que necesita asesoria.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d7c8b81c-7416-4a13-b250-481326ea13a1</incoming>
      <outgoing>Id_1540d5df-5d5b-4864-97aa-8c998da67837</outgoing>
    </task>
    <serviceTask id="Id_f1a42814-5d38-4ff4-9e77-8fdbfac1822f" name="Verificar tutores asignados a la materia en el ciclo">
      <documentation>El sistema comprueba si la materia elegida tiene tutores asignados por direccion en el ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_1540d5df-5d5b-4864-97aa-8c998da67837</incoming>
      <outgoing>Id_3bca8663-0af1-40aa-a2d9-aaae1088764e</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_d52236da-df21-4bdc-9efb-dc1a608b324d" name="La materia tiene tutores asignados?" gatewayDirection="Diverging" default="Id_d7aa159d-78ec-4265-a308-6aa5aa853ece">
      <documentation>Decision automatica: sin tutores asignados no se puede continuar con la busqueda.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3bca8663-0af1-40aa-a2d9-aaae1088764e</incoming>
      <outgoing>Id_d7aa159d-78ec-4265-a308-6aa5aa853ece</outgoing>
      <outgoing>Id_f5f5d0a7-a742-4db2-99fb-952fb0b321f3</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_56318846-e07b-4c33-972c-d2c9cf221b0e" name="Materia sin tutores asignados">
      <documentation>Cierre cuando la materia elegida no tiene tutores; el alumno debe elegir otra.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d7aa159d-78ec-4265-a308-6aa5aa853ece</incoming>
    </endEvent>
    <endEvent id="Id_e3d7a7e9-9dca-48ac-b1f5-60f19bfe6636" name="Materia elegida">
      <documentation>Cierre del proceso: la materia queda elegida y el alumno puede ver sus tutores.</documentation>
      <extensionElements>
