<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101800311" targetNamespace="http://www.bizagi.com/definitions/_2026101800311" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_b92d18b2-ab0f-41d4-bed5-c6a355098985" name="Consultar historial de asesorias">
    <documentation>El alumno revisa sus asesorias ya finalizadas, canceladas o rechazadas. Se diferencia del panel Mis asesorias, que muestra las citas vigentes y proximas.</documentation>
    <laneSet id="Id_74779db9-bbe3-4882-ab0b-d04732d8c9e3">
      <lane id="Id_4b96cb39-47c8-495a-829c-309b10eb9a56" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_1ca1e61d-ef29-414c-94d6-81c4e8cac82e" />
      </lane>
      <lane id="Id_5537c7fb-2f3d-476e-92c2-19fbbaff9b5d" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_ce144394-5634-41a4-875b-f910754a9340" />
      </lane>
      <lane id="Id_48f2f6a5-d91a-4536-beec-756e8d933a05" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_d80f2870-76a7-423d-9046-56db432900a5" />
      </lane>
      <lane id="Id_495acf6a-d820-41ce-8bcd-0e2551ae99ba" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_4e4670d5-606b-40f5-941e-747efe290cfb" />
      </lane>
    </laneSet>
    <startEvent id="Id_65f51992-f925-41e4-8c8a-e520a5b20f44" name="Necesita revisar sus asesorias pasadas">
      <documentation>Arranca cuando el alumno quiere ver que asesorias tomo, cuales se cancelaron o se rechazaron.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_4b4c0ba2-0812-4eb4-900a-4abe125625b4</outgoing>
    </startEvent>
    <task id="Id_b700b0ce-fcbd-4545-8034-cca9a399c975" name="Abrir historial de asesorias">
      <documentation>El alumno entra a la seccion de historial.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_4b4c0ba2-0812-4eb4-900a-4abe125625b4</incoming>
      <outgoing>Id_433ae47e-d83c-4207-ad45-1ad9c802bd54</outgoing>
    </task>
    <serviceTask id="Id_cf61b4b4-f8d6-40de-81a1-b434b0f85a45" name="Identificar al usuario y su rol desde el token">
      <documentation>El sistema toma la identidad del token de sesion, no de lo que venga en la peticion.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_433ae47e-d83c-4207-ad45-1ad9c802bd54</incoming>
      <outgoing>Id_93288807-56a0-4af4-a8d0-e1a5984656a8</outgoing>
    </serviceTask>
    <serviceTask id="Id_01ca65e3-e903-457f-abbd-bcd9e159429b" name="Consultar asesorias finalizadas, canceladas o rechazadas">
      <documentation>El sistema busca las asesorias del usuario que ya no estan vigentes, de la mas reciente a la mas antigua.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_93288807-56a0-4af4-a8d0-e1a5984656a8</incoming>
      <outgoing>Id_7aa5d898-d492-4986-ad18-f6c2fc0eb49c</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_6685f560-5085-427f-80a6-e5c774074360" name="Existen asesorias en el historial?" gatewayDirection="Diverging" default="Id_b34ffe6b-8dc9-4b45-b14b-11a0de3371ff">
      <documentation>Decision automatica segun el resultado de la consulta.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_7aa5d898-d492-4986-ad18-f6c2fc0eb49c</incoming>
      <outgoing>Id_b34ffe6b-8dc9-4b45-b14b-11a0de3371ff</outgoing>
      <outgoing>Id_0e60c038-9d32-416f-be61-969d7cbfbe18</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_efe5f1f5-cf31-4efa-ae01-8a642c9b3f0b" name="Historial vacio">
      <documentation>Cierre cuando el usuario no tiene asesorias pasadas.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b34ffe6b-8dc9-4b45-b14b-11a0de3371ff</incoming>
    </endEvent>
    <serviceTask id="Id_0c7fff03-9757-4e7f-9ee0-5757c88c7739" name="Convertir fechas a hora local del campus">
      <documentation>El sistema pasa las fechas guardadas en UTC a la hora de Tijuana.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_0e60c038-9d32-416f-be61-969d7cbfbe18</incoming>
      <outgoing>Id_4037d926-0f3f-45e5-9f40-7bfa2f11fa97</outgoing>
    </serviceTask>
    <task id="Id_0d391f23-ed49-406e-a980-c739c81b3804" name="Revisar historial de sesiones tomadas">
      <documentation>El alumno revisa estado, materia, asesor, fecha y tema de cada asesoria.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
