      <outgoing>Id_1d1434be-3811-4519-929b-d5dfeb297971</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_878c7128-fe9f-474e-9e6b-cd58c2f95b33" name="Mensaje rechazado">
      <documentation>Cierre cuando el mensaje esta vacio o el asesor no es valido.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
