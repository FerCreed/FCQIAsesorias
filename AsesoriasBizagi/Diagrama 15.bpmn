    </endEvent>
    <serviceTask id="Id_625935e8-7455-4efa-b13d-238a21830a92" name="Enviar mensaje por correo institucional">
      <documentation>El sistema envia el mensaje al correo institucional del asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
