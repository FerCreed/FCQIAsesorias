<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101807777" targetNamespace="http://www.bizagi.com/definitions/_2026101807777" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_36c1e6e3-c2c7-4969-9563-7cedbac93f48" name="Contactar con el asesor">
    <documentation>El alumno envia un mensaje a un asesor. El sistema valida el mensaje, lo envia por correo institucional y confirma el envio a ambas partes.</documentation>
    <laneSet id="Id_f81cc52a-f40b-47d5-abb5-bcb369b13a40">
      <lane id="Id_d86e227f-30b5-40e3-b79a-005ec0711dd9" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_b54e84a0-89ec-4592-8b65-923992e5a3ed" />
      </lane>
      <lane id="Id_54c5405f-3a0d-4fd8-986e-df3e4feeec8a" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_98661c0b-407d-4182-a49c-2022cf51f751" />
      </lane>
      <lane id="Id_729bb608-79d5-409e-8951-1fb6a98e7961" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_09b3aef2-2a40-440f-9b14-71a0dbf102e5" />
      </lane>
      <lane id="Id_4a3083d9-531f-45bb-ae0a-0374c403eb7c" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_1d964458-5e74-4ed1-a55c-5ce34e61f93d" />
      </lane>
    </laneSet>
    <startEvent id="Id_6e3b5de0-2b9d-486f-b102-5fc263d0b0c8" name="Necesita comunicarse con un asesor">
      <documentation>Arranca cuando el alumno quiere aclarar algo con el asesor antes o despues de una cita.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_42d1d712-77be-4dab-adaa-4123a63550d3</outgoing>
    </startEvent>
    <task id="Id_34c3e8dd-f488-4f0f-a80f-3078ea17531c" name="Elegir al asesor a contactar">
      <documentation>El alumno selecciona al asesor de la lista de tutores.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_42d1d712-77be-4dab-adaa-4123a63550d3</incoming>
      <outgoing>Id_2f39b5a3-d2b6-421f-b9bf-814171955ef4</outgoing>
    </task>
    <task id="Id_df700f9d-7bf0-4e9b-885a-720822745e23" name="Escribir mensaje para el asesor">
      <documentation>El alumno redacta el mensaje.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_2f39b5a3-d2b6-421f-b9bf-814171955ef4</incoming>
      <outgoing>Id_2723051e-98d1-483a-a65a-d7108aa6d25f</outgoing>
    </task>
    <serviceTask id="Id_81175eab-bdd8-4a43-83c2-afd54d69a2e0" name="Validar mensaje y datos del asesor">
      <documentation>El sistema comprueba que el mensaje no este vacio y que el asesor exista y este activo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_2723051e-98d1-483a-a65a-d7108aa6d25f</incoming>
      <outgoing>Id_caa22969-1e5b-463b-a75a-2b7df32db6a6</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_c8701b17-60fd-4530-b7b3-c2310a24d826" name="Mensaje valido?" gatewayDirection="Diverging" default="Id_b2ed60bb-23e9-499a-9ae9-b6cffb899938">
