      </extensionElements>
      <incoming>Id_2b59aae4-580a-4bdb-8230-68fd5029d295</incoming>
      <outgoing>Id_e0173d09-cd2e-439f-9d81-523d4bf757bc</outgoing>
    </serviceTask>
    <endEvent id="Id_bb81f0df-3cc6-4dd2-b62b-c99d07610c22" name="Horario actualizado">
      <documentation>Cierre del proceso: los alumnos ven el bloque con sus datos nuevos.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
