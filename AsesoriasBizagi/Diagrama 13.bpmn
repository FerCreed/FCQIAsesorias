<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101807620" targetNamespace="http://www.bizagi.com/definitions/_2026101807620" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_b003f759-d3b4-4e8a-a3c5-421b86ba4ec2" name="Editar horario">
    <documentation>El asesor cambia los datos de un bloque de horario existente (hora, cupo o lugar). El sistema valida los datos, el traslape y que no afecte citas activas antes de guardar.</documentation>
    <laneSet id="Id_d3e6cd94-f064-44a3-a2d9-bc9f49cea144">
      <lane id="Id_25fc3c4a-4b99-453b-9e02-687b81c895e3" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_f11a14f0-023a-4a4d-9457-b415d1997bb7" />
      </lane>
      <lane id="Id_c2efcc58-cc1c-4fd6-8852-11531f3360d0" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_f4f243ba-5090-4e94-9d7b-488f0f6800b8" />
      </lane>
      <lane id="Id_a78f1ad5-cda7-4562-899a-cb8d02dbbb74" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_96d029b4-268d-4863-be0b-312d71a79ee1" />
      </lane>
      <lane id="Id_b79e626d-fd0f-4141-9d2e-3040426d3c44" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_44eb6cd1-2d2d-4aae-ba1a-d703d0b1a7f0" />
      </lane>
    </laneSet>
    <startEvent id="Id_2c0ace3b-a32b-4bbc-aa3e-5295a2e0b962" name="Necesita cambiar un bloque de horario">
      <documentation>Arranca cuando el asesor quiere ajustar la hora, el cupo o el lugar de un bloque publicado.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_d11c3250-33d6-47b6-ae30-3b51574dbde1</outgoing>
    </startEvent>
    <serviceTask id="Id_d8814145-a602-4736-acd9-64c23075734c" name="Consultar horarios activos del asesor">
      <documentation>El sistema devuelve los bloques activos del asesor en el ciclo vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d11c3250-33d6-47b6-ae30-3b51574dbde1</incoming>
      <outgoing>Id_a691a43f-8399-472f-abfd-321bec880acd</outgoing>
    </serviceTask>
    <task id="Id_3acc96f3-2c76-4386-91f5-fdebabb6566a" name="Seleccionar el bloque a editar">
      <documentation>El asesor elige el bloque que quiere modificar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_a691a43f-8399-472f-abfd-321bec880acd</incoming>
      <outgoing>Id_b4f7c953-a515-4531-8351-1c569c5b736b</outgoing>
    </task>
    <task id="Id_3a595d36-0043-471f-a815-8962b7fb8583" name="Editar hora, cupo o lugar del bloque">
      <documentation>El asesor captura los nuevos datos del bloque.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b4f7c953-a515-4531-8351-1c569c5b736b</incoming>
      <outgoing>Id_01c31f2a-d399-47f8-ac48-3a3f92e3dc95</outgoing>
    </task>
    <serviceTask id="Id_81084933-821e-48b6-b4c8-7d666bc9eb05" name="Validar datos del bloque y traslape con otros bloques">
      <documentation>El sistema comprueba que la hora final sea mayor, que el cupo sea al menos 1 y que no choque con otro bloque del asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_01c31f2a-d399-47f8-ac48-3a3f92e3dc95</incoming>
      <outgoing>Id_fbdbb8fe-a5c3-4886-9a6f-4bcdb5e8557a</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_bfd427dd-bf1f-485d-ba8e-fd54b2be00de" name="Datos validos y sin traslape?" gatewayDirection="Diverging" default="Id_84145c3e-7e00-408d-b3ba-7abd586e05bc">
      <documentation>Decision automatica sobre los datos editados.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_fbdbb8fe-a5c3-4886-9a6f-4bcdb5e8557a</incoming>
      <outgoing>Id_84145c3e-7e00-408d-b3ba-7abd586e05bc</outgoing>
      <outgoing>Id_76cf9b45-038b-49cb-9dfc-9a1da90ba1ce</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_4fde4aed-9061-408f-8b86-6e6550cc6948" name="Edicion rechazada por datos invalidos o traslape">
      <documentation>Cierre cuando los datos no son validos o el bloque choca con otro.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_84145c3e-7e00-408d-b3ba-7abd586e05bc</incoming>
    </endEvent>
    <serviceTask id="Id_f0c42298-0b6b-4562-b100-3bed0964c222" name="Verificar citas activas afectadas por el cambio">
      <documentation>El sistema revisa si hay citas pendientes o confirmadas en ese bloque que dejarian de cuadrar con el cambio.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_76cf9b45-038b-49cb-9dfc-9a1da90ba1ce</incoming>
      <outgoing>Id_2773f807-05ed-464e-8bea-54842e6f0313</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_3b18012b-4fec-4dad-9667-a357217fd27b" name="Hay citas activas afectadas?" gatewayDirection="Diverging" default="Id_2b59aae4-580a-4bdb-8230-68fd5029d295">
      <documentation>Decision automatica: no se cambia un bloque si romperia citas vigentes.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_2773f807-05ed-464e-8bea-54842e6f0313</incoming>
      <outgoing>Id_77b7c788-c76e-42a0-b8a4-51deb7cac21f</outgoing>
      <outgoing>Id_2b59aae4-580a-4bdb-8230-68fd5029d295</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_b5f1e5c4-a9d8-4e20-805f-226c9aae94e2" name="Edicion rechazada por citas activas">
      <documentation>Cierre cuando el cambio afectaria citas vigentes; el asesor debe resolverlas primero.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_77b7c788-c76e-42a0-b8a4-51deb7cac21f</incoming>
    </endEvent>
    <serviceTask id="Id_5cca8a7f-0d55-4f4d-a0af-c90eeb6653b5" name="Guardar cambios del bloque en el sistema">
      <documentation>El sistema almacena los nuevos datos del bloque.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
