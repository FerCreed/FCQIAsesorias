<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101803052" targetNamespace="http://www.bizagi.com/definitions/_2026101803052" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_34c4cb51-83cc-4c3c-a3ea-3fc635adecb5" name="Configurar disponibilidad">
    <documentation>El asesor define sus bloques semanales de atencion (dia, hora, cupo y lugar o enlace) y el sistema los valida y publica para que los alumnos los vean.</documentation>
    <laneSet id="Id_010eecd4-19a9-47e3-a3d4-eacfd37f9696">
      <lane id="Id_05843f44-f26e-480a-9433-15c21ff96327" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_90dd0ed3-b303-417c-89ce-ed152aef72ea" />
      </lane>
      <lane id="Id_5bf53e42-a30d-4488-8f05-112eeb73a5e5" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_8f011eab-821e-471a-a099-264b48f3b48b" />
      </lane>
      <lane id="Id_4d9b70ba-2a1e-4a77-9b74-74863981d3ef" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_0af772ce-9a8d-4b85-a5ca-f8545f1d5cd3" />
      </lane>
      <lane id="Id_9bca1a46-a678-487d-9065-0d24d3b87fb0" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_78f3fa2d-3c82-4471-bc69-8d44fb0d40bc" />
      </lane>
    </laneSet>
    <startEvent id="Id_65a262e6-9094-4e46-a47e-8b049765a28f" name="Inicio de periodo (asesor)">
      <documentation>Arranca el flujo de configuracion que el asesor hace antes de recibir reservas.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_fd6621ea-4861-48f6-b6c3-eb6b0b479a17</outgoing>
    </startEvent>
    <task id="Id_33997298-c494-4eb0-8da2-477c01cebff2" name="Configurar disponibilidad semanal, cupo por sesion y ubicacion/enlace">
      <documentation>El asesor captura dia, hora de inicio y fin, cuantos alumnos caben por sesion y si atiende en cubiculo o por enlace virtual.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_fd6621ea-4861-48f6-b6c3-eb6b0b479a17</incoming>
      <outgoing>Id_da3e6e3c-4331-4b9f-8b84-c0bd157ad698</outgoing>
    </task>
    <serviceTask id="Id_a8170d2c-41d9-48bb-a176-e69b1856e1b6" name="Validar rango de horas y cupo minimo">
      <documentation>El sistema comprueba que la hora final sea mayor que la inicial y que el cupo sea al menos 1.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_da3e6e3c-4331-4b9f-8b84-c0bd157ad698</incoming>
      <outgoing>Id_61526d6a-e258-4f1e-820a-69ef7a0c338e</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_442db45a-b6b3-434a-9a89-15ebafa88713" name="Datos del bloque validos?" gatewayDirection="Diverging" default="Id_934f0080-7681-43f7-b185-eab3dcae78ea">
      <documentation>Decision automatica sobre los datos capturados del bloque.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_61526d6a-e258-4f1e-820a-69ef7a0c338e</incoming>
      <outgoing>Id_934f0080-7681-43f7-b185-eab3dcae78ea</outgoing>
      <outgoing>Id_494f9379-d21a-4893-9b68-e42409767f1f</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_087d802b-24cc-474a-9919-321844592a38" name="Bloque rechazado por datos invalidos">
      <documentation>Cierre cuando las horas o el cupo no son validos; el asesor debe corregirlos.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_934f0080-7681-43f7-b185-eab3dcae78ea</incoming>
    </endEvent>
    <serviceTask id="Id_e86040ad-ada4-4d9f-9d26-5b99619dbec6" name="Verificar traslape con otros bloques del asesor">
      <documentation>El sistema revisa que el bloque no choque con otro bloque del mismo asesor en el ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_494f9379-d21a-4893-9b68-e42409767f1f</incoming>
      <outgoing>Id_9aafc7f2-880a-44a4-800c-4e7e8f494cd6</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_fd9a3a56-a098-484d-873f-b8bb34ba5065" name="Se traslapa con otro bloque?" gatewayDirection="Diverging" default="Id_472e6723-88a6-4601-a475-99c087f7cb37">
      <documentation>Decision automatica: un asesor no puede tener dos bloques encimados.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_9aafc7f2-880a-44a4-800c-4e7e8f494cd6</incoming>
      <outgoing>Id_ccdc9f79-fe76-4c09-b3cd-bb329ad9528b</outgoing>
      <outgoing>Id_472e6723-88a6-4601-a475-99c087f7cb37</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_28be9426-6d46-48c6-be3f-d13be7824928" name="Bloque rechazado por traslape">
      <documentation>Cierre cuando el bloque coincide con otro ya registrado.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_ccdc9f79-fe76-4c09-b3cd-bb329ad9528b</incoming>
    </endEvent>
    <serviceTask id="Id_806867d6-9673-439a-8e38-b3bc84dd6b6a" name="Guardar disponibilidad en el sistema">
      <documentation>El sistema almacena el bloque con su horario, cupo y lugar para el ciclo vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_472e6723-88a6-4601-a475-99c087f7cb37</incoming>
      <outgoing>Id_bca20798-1d91-41df-b3cc-7e6c8a6dea6e</outgoing>
    </serviceTask>
    <endEvent id="Id_09aac50b-45f6-443d-a58a-f45ca3615c74" name="Disponibilidad publicada">
      <documentation>Cierre del proceso: los alumnos ya pueden ver el bloque en el buscador.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
