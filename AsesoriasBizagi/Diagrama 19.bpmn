<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101803766" targetNamespace="http://www.bizagi.com/definitions/_2026101803766" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_404056a5-b67f-4ab6-bbdb-16ab787ff180" name="Revisar MisAsesorias">
    <documentation>La persona abre su panel de asesorias vigentes y proximas. El alumno ve las que pidio, el asesor las que le tocan y el personal administrativo todas.</documentation>
    <laneSet id="Id_64740eb8-0123-4dfb-8915-c205bd298121">
      <lane id="Id_f4a8c08c-8812-4047-a82b-13299599be3b" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_ea1468cb-4814-4001-8b1d-93fc43f2e50d" />
      </lane>
      <lane id="Id_7096f49c-3bc2-4f2b-9718-fdf7ae3c67a1" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_e8b5c7d6-b42c-436a-b62e-38cb70535be5" />
      </lane>
      <lane id="Id_6ce9909f-c392-4997-b9b0-c2db117aedf9" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_b0252ea1-ee96-41e8-9b83-3d3659039701" />
      </lane>
      <lane id="Id_840d5310-dcff-462c-8b85-4748243e5a4e" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_b11f8c51-e058-48ea-a6d5-f342375b0a20" />
      </lane>
    </laneSet>
    <startEvent id="Id_a7e4acef-375d-436f-a89c-bd2da4c76dae" name="Necesita revisar sus asesorias">
      <documentation>Arranca cuando la persona quiere ver el estado de sus asesorias.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_db48723a-2630-477a-9ad7-e708e3d16613</outgoing>
    </startEvent>
    <task id="Id_b6dd08f8-4815-48b3-aefb-67528e7ef5b2" name="Consultar panel &quot;mis asesorias&quot; (historial y proximas citas)">
      <documentation>La persona abre la pantalla Mis asesorias, o Solicitudes si es asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_db48723a-2630-477a-9ad7-e708e3d16613</incoming>
      <outgoing>Id_e66338e4-32ee-460b-9869-3c477a2f9377</outgoing>
    </task>
    <serviceTask id="Id_9a026ae6-1af6-407e-9f50-5149df75e322" name="Identificar al usuario y su rol desde el token">
      <documentation>El sistema toma la identidad del token y decide que citas le corresponden segun su rol.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_e66338e4-32ee-460b-9869-3c477a2f9377</incoming>
      <outgoing>Id_bab90abf-d62d-4053-a17b-5ca239b2363c</outgoing>
    </serviceTask>
    <serviceTask id="Id_21b0ea58-cc1e-4d2b-9e36-a5ec38ee5860" name="Consultar historial y proximas citas">
      <documentation>El sistema busca las asesorias del usuario, de la mas reciente a la mas antigua. Pedir las de otra persona devuelve un error de permiso.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_bab90abf-d62d-4053-a17b-5ca239b2363c</incoming>
      <outgoing>Id_f496b152-005f-4bcf-a840-395ff737cc50</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_c8defc2e-d641-42bc-91d3-5a2bfc0d82b9" name="Existen asesorias registradas?" gatewayDirection="Diverging" default="Id_8c192bf7-f29f-495b-b249-e11dc3fc09aa">
      <documentation>Decision automatica segun el resultado de la consulta.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_f496b152-005f-4bcf-a840-395ff737cc50</incoming>
      <outgoing>Id_8c192bf7-f29f-495b-b249-e11dc3fc09aa</outgoing>
      <outgoing>Id_3da2afd8-0dcc-442d-94c2-4360e926353c</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_cf693aad-d332-4af6-ba59-b66c624bf983" name="Panel sin asesorias">
      <documentation>Cierre cuando el usuario aun no tiene asesorias.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_8c192bf7-f29f-495b-b249-e11dc3fc09aa</incoming>
    </endEvent>
    <serviceTask id="Id_a2de1238-1f4e-4659-890c-6a59ddee7a4c" name="Convertir fechas a hora local del campus">
      <documentation>El sistema pasa las fechas guardadas en UTC a la hora de Tijuana.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3da2afd8-0dcc-442d-94c2-4360e926353c</incoming>
      <outgoing>Id_e41de87d-e372-4516-8db2-a992111e774d</outgoing>
    </serviceTask>
    <task id="Id_5f5101e7-d382-49f7-ab58-c5ef84eba757" name="Revisar estado y detalle de sus asesorias">
      <documentation>La persona revisa estado, materia, participantes, fecha y tema; desde aqui puede elegir una para cancelarla, aceptarla o rechazarla.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
