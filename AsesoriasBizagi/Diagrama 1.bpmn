<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101806988" targetNamespace="http://www.bizagi.com/definitions/_2026101806988" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_d6e4910e-0797-4fbf-baac-11d328f53e00" name="Inicio sesion">
    <documentation>Acceso de una persona al sistema con su correo institucional: valida el dominio, resuelve sus roles y emite el token de sesion. Aplica igual a alumno, asesor y directivo.</documentation>
    <laneSet id="Id_d055dd76-4efb-4615-b8be-60bf24cb9766">
      <lane id="Id_8ccf6003-c5f2-4192-9cc9-44dd6c7a3c0f" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_c95f37d4-3e41-4264-ba80-e2f8d9dc246a" />
      </lane>
      <lane id="Id_c1df839d-dbf4-483f-b907-b1252914cce5" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_93ee0337-e35b-4f6e-9b37-7d3418aa506b" />
      </lane>
      <lane id="Id_82956083-b10f-4a4b-b6d9-ccdaaf010b19" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_b45b924d-083c-4bbd-9fda-96044ea63548" />
      </lane>
      <lane id="Id_0a94f19a-3332-4d98-b2a3-914c92e4453e" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_b3337cba-af69-40b1-abdf-cefaa4eb6ae9" />
      </lane>
    </laneSet>
    <startEvent id="Id_e652a5ce-61f1-4770-a53f-a5febb042320" name="Iniciar sesion institucional">
      <documentation>Punto de entrada: la persona decide acceder al sistema con su correo institucional. El flujo es el mismo para alumno, asesor o directivo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_0e59719c-0f10-483f-8551-129daee6e641</outgoing>
    </startEvent>
    <task id="Id_2762a9ce-38db-40a6-9bc4-682249d9c3a4" name="Capturar correo institucional o elegir perfil de acceso">
      <documentation>La persona escribe su correo @uabc.edu.mx o elige su perfil en el acceso de demostracion.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_0e59719c-0f10-483f-8551-129daee6e641</incoming>
      <outgoing>Id_9e62b03f-3249-4627-98eb-ca48082c7b6d</outgoing>
    </task>
    <serviceTask id="Id_339da77b-996b-47bb-8206-4e16950177f1" name="Validar credenciales institucionales">
      <documentation>El sistema comprueba que el correo pertenezca al dominio @uabc.edu.mx y, si el acceso es con Google, que el token sea autentico.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_9e62b03f-3249-4627-98eb-ca48082c7b6d</incoming>
      <outgoing>Id_b7b64979-ac87-42b4-b4a4-45328fe3d56a</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_65b044e4-7a8e-4c0d-b492-c8b36dc76f77" name="Credenciales validas?" gatewayDirection="Diverging" default="Id_972cf04b-64e0-4200-8402-840d116f703b">
      <documentation>Decision automatica: si el correo no es institucional o el token no es valido se niega el acceso.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b7b64979-ac87-42b4-b4a4-45328fe3d56a</incoming>
      <outgoing>Id_972cf04b-64e0-4200-8402-840d116f703b</outgoing>
      <outgoing>Id_74c271e8-4084-4594-9c26-20e9f665d0b6</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_d2fa91a7-7192-4914-a292-1bf543e5e4c3" name="Acceso denegado">
      <documentation>Cierre del proceso cuando las credenciales no pasan la validacion.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_972cf04b-64e0-4200-8402-840d116f703b</incoming>
    </endEvent>
    <serviceTask id="Id_2d3cb2f9-4c05-49a1-9e1e-a3d3be04cf78" name="Resolver roles de la persona">
      <documentation>El sistema busca a la persona por su correo y reune todos sus perfiles activos: alumno, asesor y directivo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_74c271e8-4084-4594-9c26-20e9f665d0b6</incoming>
      <outgoing>Id_08e76737-0db3-42f2-955d-33bcd79b5ba4</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_7e3fe778-6626-463d-96d7-4684c92df7b6" name="Persona registrada con algun rol activo?" gatewayDirection="Diverging" default="Id_3b2aded3-2c60-43c6-bd37-6b0a6e47371a">
      <documentation>Decision automatica: la persona debe existir en el programa y tener al menos un perfil activo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_08e76737-0db3-42f2-955d-33bcd79b5ba4</incoming>
      <outgoing>Id_3b2aded3-2c60-43c6-bd37-6b0a6e47371a</outgoing>
      <outgoing>Id_710eae3b-b99a-46d5-8a76-bce47dd04c0f</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_b99ef4d0-ceef-401d-a24d-fc0469bfda9e" name="Acceso denegado por correo no registrado">
      <documentation>Cierre cuando el correo es institucional pero la persona no esta dada de alta en el programa de asesorias.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_3b2aded3-2c60-43c6-bd37-6b0a6e47371a</incoming>
    </endEvent>
    <serviceTask id="Id_a373092a-90b7-429a-8a52-c111122e7e1c" name="Emitir token de sesion con sus roles">
      <documentation>El sistema genera el token de sesion, con vigencia de 8 horas, que lleva la identidad y todos los roles de la persona.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_710eae3b-b99a-46d5-8a76-bce47dd04c0f</incoming>
      <outgoing>Id_64e88b26-2526-4f08-ae48-0a4a0cf14c79</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_1e281a58-fbeb-40f1-856a-a4a99ebd9111" name="Tiene mas de un rol?" gatewayDirection="Diverging" default="Id_d4d26ca5-dc27-47f1-b366-b92e55394dd3">
      <documentation>Decision automatica: solo se ofrece elegir rol si la persona tiene varios, por ejemplo asesor y alumno a la vez.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_64e88b26-2526-4f08-ae48-0a4a0cf14c79</incoming>
      <outgoing>Id_84c3bc0d-1be8-4bb5-a863-4393f3bbd6f4</outgoing>
      <outgoing>Id_d4d26ca5-dc27-47f1-b366-b92e55394dd3</outgoing>
    </exclusiveGateway>
    <task id="Id_ff647c63-c041-420b-8336-55c9616e89a5" name="Elegir rol con Entrar como">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;La persona escoge con que rol usara el sistema; puede cambiarlo despues sin volver a autenticarse.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_84c3bc0d-1be8-4bb5-a863-4393f3bbd6f4</incoming>
      <outgoing>Id_41286602-bd3d-4095-9bf4-1dfae8626700</outgoing>
    </task>
    <endEvent id="Id_1872bdcf-48f1-4c8b-b14b-625a11cf52a5" name="Sesion iniciada">
      <documentation>Cierre del proceso: la persona entra a su pantalla de inicio segun el rol activo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
