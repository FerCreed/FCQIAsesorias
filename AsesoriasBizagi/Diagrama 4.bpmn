<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101800204" targetNamespace="http://www.bizagi.com/definitions/_2026101800204" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_140823d1-0ee0-4608-8c48-375767ba4983" name="Consultar asesores">
    <documentation>El alumno consulta los tutores que direccion asigno a una materia del ciclo vigente.</documentation>
    <laneSet id="Id_8bd22674-12dc-4a05-99e4-7878ebec6b0f">
      <lane id="Id_3f42e606-0b29-40aa-9a30-efc096b7843c" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_642ca099-2f89-43d1-9543-20e17daddadb" />
      </lane>
      <lane id="Id_3e7a2376-498c-42f4-a62a-0c94ffa6da35" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_fadac9d1-d0a8-4d60-95ae-3df4156191f9" />
      </lane>
      <lane id="Id_9e9dbddc-4678-4c01-ba2d-5f99431d4560" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_a89cef16-a8ac-462a-bcd3-1a9e44e939d2" />
      </lane>
      <lane id="Id_b625fd46-4f0e-4b90-8138-d83edc0dfaa9" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_79c3b84b-39d0-4330-a449-785d3e080ce1" />
      </lane>
    </laneSet>
    <startEvent id="Id_d663754d-70b0-4280-954e-6e4c84698f56" name="Necesita elegir un asesor">
      <documentation>Arranca cuando el alumno ya sabe la materia y busca quien se la puede asesorar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_276f159d-645e-42a7-9279-e341d63ac7dc</outgoing>
    </startEvent>
    <task id="Id_1c6007f3-e8b0-4448-bc40-1b74c8ae3ba8" name="Indicar la materia de interes">
      <documentation>El alumno indica la materia para la que quiere asesoria.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_276f159d-645e-42a7-9279-e341d63ac7dc</incoming>
      <outgoing>Id_44ab4cd8-86a9-4635-9329-e9302fed26c7</outgoing>
    </task>
    <serviceTask id="Id_6c6aeda3-a238-4c44-88d7-4194c8f64e7b" name="Consultar tutores asignados a la materia en el ciclo vigente">
      <documentation>El sistema busca los tutores activos que direccion asigno a esa materia en el ciclo vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_44ab4cd8-86a9-4635-9329-e9302fed26c7</incoming>
      <outgoing>Id_e03592a2-8a8d-401d-9cab-f679b79a6be3</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_bbc38551-bb0d-4be0-84b0-d130d557ec0e" name="Hay tutores asignados a la materia?" gatewayDirection="Diverging" default="Id_10c50a52-3923-48e7-b204-d41939bcd488">
      <documentation>Decision automatica: si ningun tutor tiene la materia asignada no hay asesores que ofrecer.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_e03592a2-8a8d-401d-9cab-f679b79a6be3</incoming>
      <outgoing>Id_10c50a52-3923-48e7-b204-d41939bcd488</outgoing>
      <outgoing>Id_bc08b5d0-fe7f-45c4-99cd-a598f5288fb7</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_b205105f-a0a5-493c-8ef2-e9b702ef29ce" name="Materia sin tutores asignados">
      <documentation>Cierre cuando la materia no tiene tutores asignados en el ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_10c50a52-3923-48e7-b204-d41939bcd488</incoming>
    </endEvent>
    <serviceTask id="Id_9cd0b647-5dd0-4453-baf0-a37ce8b494f3" name="Armar lista de tutores con programa y modalidad">
      <documentation>El sistema arma la lista ordenada por apellido, con el programa educativo y la modalidad predeterminada de cada tutor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_bc08b5d0-fe7f-45c4-99cd-a598f5288fb7</incoming>
      <outgoing>Id_4b163252-96dc-469d-a606-05fcabf11b59</outgoing>
    </serviceTask>
    <task id="Id_28aeea1d-09eb-489a-8812-43577c3c5ce1" name="Revisar tutores asignados por direccion">
      <documentation>El alumno revisa la lista de tutores y decide con cual agendar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_4b163252-96dc-469d-a606-05fcabf11b59</incoming>
      <outgoing>Id_2b31f107-a006-4a7a-b37e-cc2d532d7269</outgoing>
    </task>
    <endEvent id="Id_3bbfc130-9cae-4969-8997-5b37a568006d" name="Asesores consultados">
      <documentation>Cierre del proceso: el alumno conoce a los tutores disponibles para la materia.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
