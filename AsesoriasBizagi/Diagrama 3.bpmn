<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101800494" targetNamespace="http://www.bizagi.com/definitions/_2026101800494" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_6a886a37-b6c3-48a1-a291-ea1f89b3519c" name="Consultar horarios">
    <documentation>El alumno consulta los bloques de horario activos de un tutor, con su sede, modalidad y cupo, para poder elegir uno.</documentation>
    <laneSet id="Id_d949e9b7-73e6-4e2f-a572-211819772928">
      <lane id="Id_7fc2ad22-201b-47be-8391-0b3bb20280f2" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_c386d824-dd9f-46cd-bb30-19e92c252a19" />
      </lane>
      <lane id="Id_d385dcee-9996-44e9-babe-1ef9306ba3b3" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_7b5b531d-e519-4ab5-8892-0a9d4b655e79" />
      </lane>
      <lane id="Id_a7b3284a-41f0-457a-b9c5-7d5754fdf7d0" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_d93cfc13-c622-4e3c-bdbf-bc1824ed0490" />
      </lane>
      <lane id="Id_b27ddad5-a712-49e7-be63-456de22fc8da" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_a4c141e4-fba9-4ecb-b775-d12d27f9212f" />
      </lane>
    </laneSet>
    <startEvent id="Id_17477eb8-b18c-4fda-ad24-f98f67263e56" name="Necesita conocer los horarios de un asesor">
      <documentation>Arranca cuando el alumno ya eligio un tutor y quiere ver cuando atiende.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_f62dc2ea-7c27-42be-b6d4-314c7e427db3</outgoing>
    </startEvent>
    <task id="Id_f9f1e87d-8148-4c73-80ec-c8ce1c521b9b" name="Seleccionar tutor de la lista">
      <documentation>El alumno elige al tutor cuyos horarios quiere revisar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_f62dc2ea-7c27-42be-b6d4-314c7e427db3</incoming>
      <outgoing>Id_17f3a1a4-0668-4d9e-bee0-1cd260f0b133</outgoing>
    </task>
    <serviceTask id="Id_f6b865e7-3aac-4a68-9de9-c527263dc097" name="Consultar horarios activos del tutor en el ciclo vigente">
      <documentation>El sistema busca los bloques de horario activos del tutor en el ciclo escolar vigente, ordenados por dia y hora.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_17f3a1a4-0668-4d9e-bee0-1cd260f0b133</incoming>
      <outgoing>Id_ca4e5ff4-3c09-45cf-b289-e3b7591c7c03</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_176ed1b8-6f1b-444c-9e60-62bc3964024c" name="¿El tutor tiene horarios activos?" gatewayDirection="Diverging" default="Id_f8c376c2-743b-462c-a869-14cbd7b5539c">
      <documentation>Decision automatica: si el tutor no tiene bloques activos no hay nada que mostrar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_ca4e5ff4-3c09-45cf-b289-e3b7591c7c03</incoming>
      <outgoing>Id_f8c376c2-743b-462c-a869-14cbd7b5539c</outgoing>
      <outgoing>Id_028a5e14-8b1f-445b-b375-c8f63bf3c252</outgoing>
    </exclusiveGateway>
    <endEvent id="Id_f018b84b-5909-4289-baea-8173911d34cb" name="Sin horarios disponibles">
      <documentation>Cierre cuando el tutor no tiene bloques de horario activos en el ciclo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#EEAAAA" />
            <bizagi:BizagiProperty name="borderColor" value="#990000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_f8c376c2-743b-462c-a869-14cbd7b5539c</incoming>
    </endEvent>
    <serviceTask id="Id_a3721c2e-ff3e-4624-9526-a39543acf0d3" name="Obtener sede, modalidad y cupo de cada bloque">
      <documentation>El sistema agrega a cada bloque su lugar, su modalidad (presencial o virtual) y su cupo maximo.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_028a5e14-8b1f-445b-b375-c8f63bf3c252</incoming>
      <outgoing>Id_f93d3e6c-2d4a-4ff6-be36-cc8b13f8cda0</outgoing>
    </serviceTask>
    <task id="Id_fd7a8af4-877f-4c9c-be39-59d558a300cb" name="Revisar horarios disponibles (dia, hora, modalidad y lugar)">
      <documentation>El alumno revisa los bloques que se le muestran y decide cual le conviene.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_f93d3e6c-2d4a-4ff6-be36-cc8b13f8cda0</incoming>
      <outgoing>Id_bb2975f4-f14b-4163-80d7-b0db8931a5db</outgoing>
    </task>
    <endEvent id="Id_64812bec-bfa1-45a9-b43c-91d6355f2863" name="Horarios consultados">
      <documentation>Cierre del proceso: el alumno ya conoce los horarios del tutor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
