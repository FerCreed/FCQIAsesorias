    </exclusiveGateway>
    <endEvent id="Id_7bc73e6e-f78b-4113-8161-27921ee94c95" name="Solicitud rechazada (fuera de tiempo limite)">
      <documentation>Cierre cuando el plazo ya vencio; la cita se conserva.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
