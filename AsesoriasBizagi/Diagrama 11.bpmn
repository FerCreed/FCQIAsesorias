    <serviceTask id="Id_dfa7239c-c06d-4570-bb20-ccbeb4e9da4b" name="Registrar cambio en el historial de estados">
      <documentation>El sistema deja constancia del cambio de estado, con fecha y estado anterior y nuevo.</documentation>
