      </extensionElements>
      <incoming>Id_8514b8d0-5c82-42f2-bf6f-8d9fbf3d9bca</incoming>
    </endEvent>
    <exclusiveGateway id="Id_71d39e60-6d70-4ed1-b62a-718c4d9d30f7" name="Dentro del tiempo limite para cancelar/reprogramar?" gatewayDirection="Diverging" default="Id_46076610-5753-4625-ab35-efae39f6ea12">
      <documentation>Decision automatica: compara la fecha de la cita contra el plazo permitido para cancelar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
