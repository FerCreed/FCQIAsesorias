    <serviceTask id="Id_1007ae7c-d60e-4a91-8012-85275b763043" name="Actualizar estado de la cita">
      <documentation>El sistema cambia la cita a Cancelada y libera el lugar que ocupaba en el horario.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
