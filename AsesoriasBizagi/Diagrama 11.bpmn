<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101809546" targetNamespace="http://www.bizagi.com/definitions/_2026101809546" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_820b2e7b-9bc2-4a60-85c8-043c1d139206" name="Cancelar asesoria">
    <documentation>El alumno cancela una de sus asesorias. El sistema valida que sea suya y siga vigente, revisa el tiempo limite, libera el lugar, registra el cambio y avisa al asesor.</documentation>
    <laneSet id="Id_3523076c-83c6-4849-8685-b1bc6c3aeaca">
      <lane id="Id_8f1c98f8-60d6-46ed-90d7-f5508d70f343" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_787d4ed5-b64a-4833-850c-b3041e3f2b47" />
      </lane>
      <lane id="Id_6c86b343-9e33-41a1-afec-7b0157763c49" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_d35cd511-a691-4bf1-8b89-ea3cc55a9b02" />
      </lane>
      <lane id="Id_9a44cbd5-d792-4922-b89f-fc66e4b55397" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_9e6c3811-a8e2-4842-979d-734c176fe117" />
      </lane>
      <lane id="Id_be8da47e-3a3e-4883-8a04-22d5013f17c0" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_47b990b6-b348-4aeb-b86b-d679dd9139e9" />
      </lane>
    </laneSet>
    <startEvent id="Id_b881bd8b-c5a7-4e99-80a9-68dbd91a0a4c" name="Necesita cancelar una asesoria">
      <documentation>Arranca cuando el alumno ya no puede o ya no quiere asistir a una asesoria solicitada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
            <bizagi:BizagiProperty name="borderColor" value="#62A716" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <outgoing>Id_bdd68ed5-520e-4842-bf6c-7ed178be3cc2</outgoing>
    </startEvent>
    <task id="Id_ec41e7c2-6c57-4afc-a0d8-1c0597dea715" name="Seleccionar la asesoria a cancelar">
      <documentation>El alumno elige la asesoria de su lista de citas.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_bdd68ed5-520e-4842-bf6c-7ed178be3cc2</incoming>
      <outgoing>Id_d90e9ed0-ed5d-4547-82e8-75d4a27116f4</outgoing>
    </task>
    <task id="Id_aab6d612-7eec-4c5a-9b49-c8fb2123c9d3" name="Cancelar o reprogramar cita">
      <documentation>El alumno solicita la baja de la cita. En este proceso la accion es cancelar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d90e9ed0-ed5d-4547-82e8-75d4a27116f4</incoming>
      <outgoing>Id_eb852261-a9a9-4300-9f4a-31085112c73b</outgoing>
    </task>
    <serviceTask id="Id_6a521d15-1efe-48d6-829d-e18442eeea25" name="Validar propiedad y estado de la asesoria">
      <documentation>El sistema comprueba que la asesoria sea del alumno y que no este ya cancelada o rechazada.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#03689A" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="runtimeProperties" value="{&quot;cost&quot;:0,&quot;priority&quot;:0,&quot;isBot&quot;:false,&quot;asynchronousBehavior&quot;:{}}" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_eb852261-a9a9-4300-9f4a-31085112c73b</incoming>
      <outgoing>Id_1beead26-79f5-461f-a4e9-53e48b2daf22</outgoing>
    </serviceTask>
    <exclusiveGateway id="Id_235038f5-4c8d-4cc9-8d63-81cafccc6dd4" name="Asesoria propia y en estado Pendiente o Confirmada?" gatewayDirection="Diverging" default="Id_8514b8d0-5c82-42f2-bf6f-8d9fbf3d9bca">
      <documentation>Decision automatica: solo se cancela una asesoria propia y vigente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
            <bizagi:BizagiProperty name="borderColor" value="#A6A61D" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
