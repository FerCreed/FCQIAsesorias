    </endEvent>
    <task id="Id_83890837-483a-4966-acdc-0022428c403e" name="Aceptar cita de asesoria">
      <documentation>El asesor confirma la solicitud con el boton Confirmar.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
