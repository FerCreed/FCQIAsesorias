    <exclusiveGateway id="Id_638c3cf4-2120-4fb0-a291-7021d242f6b1" name="Solicitud valida para confirmar?" gatewayDirection="Diverging" default="Id_bf39a6a0-5022-4f66-ad50-8abc832e7432">
