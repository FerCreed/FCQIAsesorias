      <outgoing>Id_846bf0e8-9baa-46f0-9593-f25bf66168d2</outgoing>
    </task>
    <exclusiveGateway id="Id_82928d2f-8afa-4037-9582-4db8c081e631" name="El asesor acepta la solicitud?" gatewayDirection="Diverging" default="Id_03218f99-08de-46cc-879a-05044843c6a2">
      <documentation>Decision humana del asesor sobre la solicitud.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFCC" />
