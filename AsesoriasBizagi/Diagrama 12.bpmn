      <outgoing>Id_c8e182fa-750d-4780-b342-b18773da792a</outgoing>
    </task>
    <serviceTask id="Id_0f371e45-771e-4bb9-a96c-e54517aef9fc" name="Consultar solicitudes pendientes del asesor">
      <documentation>El sistema devuelve las asesorias que le tocan a ese asesor, mas recientes primero.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
