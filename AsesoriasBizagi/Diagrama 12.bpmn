      </extensionElements>
      <outgoing>Id_e61d40d7-8b32-4ab0-a5da-c6daa33725b6</outgoing>
    </startEvent>
    <task id="Id_aab2e4f3-1b90-4ccb-ba21-d3fbe21bf367" name="Recibir notificacion de nueva cita">
      <documentation>El asesor es avisado de que tiene una solicitud nueva.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
