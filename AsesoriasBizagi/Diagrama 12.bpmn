      <incoming>Id_e61d40d7-8b32-4ab0-a5da-c6daa33725b6</incoming>
      <outgoing>Id_99111d4a-4fd7-4bd9-b67c-93fc7ac1d0b5</outgoing>
    </task>
    <task id="Id_f3c2652e-e0b1-4d0d-ab65-5906dd785d53" name="Consultar bandeja de solicitudes">
      <documentation>El asesor abre su bandeja de solicitudes.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
