      <outgoing>Id_3aff4b60-1c20-487b-a970-21a78a2ca7e7</outgoing>
    </serviceTask>
    <task id="Id_a924a717-c518-4533-bb79-e1f2d191f6e6" name="Revisar solicitud">
      <documentation>El asesor revisa materia, alumno, fecha y tema de la solicitud.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#ECEFFF" />
