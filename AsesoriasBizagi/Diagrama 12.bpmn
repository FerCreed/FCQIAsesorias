<?xml version="1.0"?>
<definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="_2026101808359" targetNamespace="http://www.bizagi.com/definitions/_2026101808359" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <process id="Id_60919e23-7e3d-4b76-9f8b-b3e1bf1ca649" name="Aceptar cita de asesoria">
    <documentation>El asesor revisa una solicitud pendiente y la acepta. El sistema valida que sea suya, la confirma, deja el historial, avisa al alumno y sincroniza la cita con el calendario del asesor.</documentation>
    <laneSet id="Id_e880098a-299c-4685-9ab5-543345ef123b">
      <lane id="Id_bf2bbf93-56f3-45cc-8d86-0f8374caa0b0" name="Alumno">
        <documentation>Carril del alumno: persona que busca, solicita y consulta asesorias.</documentation>
        <childLaneSet id="Id_f13d3b72-5952-40d2-926f-6f60cbba6d5f" />
      </lane>
      <lane id="Id_5ec1a936-808c-4ee5-b4fb-cd94db501dac" name="Sistema">
        <documentation>Carril del sistema: validaciones, consultas, registros y notificaciones automaticas.</documentation>
        <childLaneSet id="Id_d5992020-dea0-4e68-a904-ad23db735df8" />
      </lane>
      <lane id="Id_37df3003-0256-4cce-8a59-295430786869" name="Asesor">
        <documentation>Carril del asesor: tutor que configura horarios, atiende solicitudes e imparte las sesiones.</documentation>
        <childLaneSet id="Id_f4a1a851-20bb-4231-91d0-4ee911c86215" />
      </lane>
      <lane id="Id_f5df11fa-7e27-452b-bf9b-b2022a54b782" name="Administrativo">
        <documentation>Carril del personal administrativo (direccion): catalogos, asignaciones y reportes.</documentation>
        <childLaneSet id="Id_727ab36a-dc14-4e7b-b1f6-bf23d1964ff5" />
      </lane>
    </laneSet>
    <startEvent id="Id_17f87a05-2495-4f03-9c91-ecc2f0937bea" name="Nueva solicitud pendiente">
      <documentation>Arranca cuando un alumno solicita una asesoria y la solicitud queda pendiente.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E6FF97" />
