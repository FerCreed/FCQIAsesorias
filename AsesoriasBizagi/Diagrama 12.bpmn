  <collaboration id="Id_2e79f266-0a94-4ac7-9026-66e71fef97cc" name="Diagrama 12">
    <documentation />
    <participant id="Id_9a09c821-31f9-490a-923c-2e932d32b17e" name="Aceptar cita de asesoria" processRef="Id_60919e23-7e3d-4b76-9f8b-b3e1bf1ca649">
      <documentation>El asesor revisa una solicitud pendiente y la acepta. El sistema valida que sea suya, la confirma, deja el historial, avisa al alumno y sincroniza la cita con el calendario del asesor.</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
