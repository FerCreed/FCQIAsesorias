<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCQI.Web.ViewModels"
             xmlns:models="using:FCQI.Web.Models"
             x:Class="FCQI.Web.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="White" BoxShadow="0 1 8 0 #22000000" ZIndex="2">
            <StackPanel Margin="20,10" Spacing="6">
                <TextBlock Text="UNIVERSIDAD AUTÓNOMA DE BAJA CALIFORNIA"
                           FontSize="11" LetterSpacing="1.4" Foreground="#024731" TextWrapping="Wrap" />
                <TextBlock Text="Facultad de Ciencias Químicas e Ingeniería"
                           FontSize="18" FontWeight="SemiBold" Foreground="#00723F" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Classes="nav" Content="Inicio" Command="{Binding GoCommand}" CommandParameter="home" />
                    <Button Classes="nav" Content="Catálogo" Command="{Binding GoCommand}" CommandParameter="search" />
                    <Button Classes="nav" Content="Mis asesorías" Command="{Binding GoCommand}" CommandParameter="sessions"
                            IsVisible="{Binding IsStudent}" />
                    <Button Classes="nav" Content="Solicitudes" Command="{Binding GoCommand}" CommandParameter="sessions"
                            IsVisible="{Binding IsAdvisor}" />
                    <Button Classes="nav" Content="Dirección" Command="{Binding GoCommand}" CommandParameter="admin"
                            IsVisible="{Binding IsAdmin}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Margin="8,0,0,0" IsVisible="{Binding CanSwitchRole}">
                        <TextBlock Text="Entrar como" VerticalAlignment="Center"
                                   FontSize="12" Foreground="#024731" />
                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding ActiveRole}"
                                  MinWidth="120" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Classes="ghost" Content="Iniciar sesión" Command="{Binding OpenLoginCommand}"
                            IsVisible="{Binding IsGuest}" Margin="8,4,0,0" />
                    <Button Classes="ghost" Content="Cerrar sesión" Command="{Binding LogoutCommand}"
                            IsVisible="{Binding IsLoggedIn}" Margin="8,4,0,0" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Background="#F7F4EE">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !ShowSearch}">
                <StackPanel>
                    <Border Background="#024731" Padding="32,28" IsVisible="{Binding ShowHero}">
                        <StackPanel MaxWidth="980" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="{Binding Welcome}"
                                       FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RoleHint}"
                                       Foreground="#E7F3EA" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Foreground="#FEBE10" TextWrapping="Wrap" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="20,24" Spacing="18">
                        <Border IsVisible="{Binding ShowLogin}" Background="White" Padding="28" CornerRadius="8"
                                BoxShadow="0 8 24 0 #14000000" MaxWidth="520" HorizontalAlignment="Center">
                            <StackPanel Spacing="14">
                                <TextBlock Text="ACCESO INSTITUCIONAL" Foreground="#DD971A" FontWeight="Bold" FontSize="13" LetterSpacing="1.2" />
                                <TextBlock Text="Inicia sesión" FontSize="24" FontWeight="SemiBold" Foreground="#024731" />
                                <TextBlock TextWrapping="Wrap" Foreground="#555" LineHeight="22"
                                           Text="Necesitas una cuenta @uabc.edu.mx para solicitar una asesoría o para entrar como tutor o dirección. El catálogo se puede consultar sin iniciar sesión." />
                                <TextBlock Text="Correo institucional" FontWeight="SemiBold" Foreground="#024731" />
                                <TextBox Watermark="nombre.apellido@uabc.edu.mx" Text="{Binding Email}" />
                                <TextBlock Text="Contraseña" FontWeight="SemiBold" Foreground="#024731" />
                                <TextBox Watermark="Contraseña" PasswordChar="●" Text="{Binding Password}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#777"
                                           Text="Mientras no haya directorio UABC, no se verifica la contraseña: basta un correo @uabc.edu.mx y cualquier contraseña." />
                                <TextBlock Text="{Binding LoginError}" TextWrapping="Wrap"
                                           Foreground="#B42318" FontWeight="SemiBold"
                                           IsVisible="{Binding HasLoginError}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Classes="cta" Content="Ingresar" Command="{Binding LoginCommand}"
                                            IsEnabled="{Binding !IsBusy}" />
                                    <Button Classes="ghost" Content="Volver al catálogo" Command="{Binding GoCommand}"
                                            CommandParameter="search" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding ShowHome}" Spacing="14">
                            <TextBlock Text="PROGRAMA DE ASESORÍAS" Foreground="#DD971A" FontWeight="Bold" LetterSpacing="1.2" />
                            <TextBlock Text="Periodo 2026-2" FontSize="24" FontWeight="SemiBold" Foreground="#024731" />
                            <TextBlock TextWrapping="Wrap" Foreground="#444"
                                       Text="Consulta el catálogo sin cuenta. Para pedir una cita usa tu correo institucional." />
                            <WrapPanel>
                                <Border Width="280" Margin="0,0,16,16" Background="White" Padding="18" CornerRadius="8"
                                        BoxShadow="0 4 16 0 #14000000">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Catálogo 2026-2" FontWeight="Bold" FontSize="16" Foreground="#00723F" />
                                        <TextBlock TextWrapping="Wrap" Text="Materias, tutores y horarios en un solo panel." />
                                        <Button Classes="cardAction" Content="Ver catálogo" Command="{Binding GoCommand}" CommandParameter="search" />
                                    </StackPanel>
                                </Border>
                                <Border Width="280" Margin="0,0,16,16" Background="White" Padding="18" CornerRadius="8"
                                        BoxShadow="0 4 16 0 #14000000" IsVisible="{Binding IsGuest}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Solicitar asesoría" FontWeight="Bold" FontSize="16" Foreground="#00723F" />
                                        <TextBlock TextWrapping="Wrap" Text="Elige materia, tutor y horario; al enviar te pediremos iniciar sesión." />
                                        <Button Classes="cardAction" Content="Iniciar sesión" Command="{Binding OpenLoginCommand}" />
                                    </StackPanel>
                                </Border>
                                <Border Width="280" Margin="0,0,16,16" Background="White" Padding="18" CornerRadius="8"
                                        BoxShadow="0 4 16 0 #14000000" IsVisible="{Binding IsStudent}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Mis citas" FontWeight="Bold" FontSize="16" Foreground="#00723F" />
                                        <TextBlock TextWrapping="Wrap" Text="Consulta el estado de tus solicitudes." />
                                        <Button Classes="cardAction" Content="Ver mis asesorías" Command="{Binding GoCommand}" CommandParameter="sessions" />
                                    </StackPanel>
                                </Border>
                                <Border Width="280" Margin="0,0,16,16" Background="White" Padding="18" CornerRadius="8"
                                        BoxShadow="0 4 16 0 #14000000" IsVisible="{Binding IsAdvisor}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Bandeja del tutor" FontWeight="Bold" FontSize="16" Foreground="#00723F" />
                                        <TextBlock TextWrapping="Wrap" Text="Confirma o rechaza solicitudes." />
                                        <Button Classes="cardAction" Content="Ver solicitudes" Command="{Binding GoCommand}" CommandParameter="sessions" />
                                    </StackPanel>
                                </Border>
                                <Border Width="280" Margin="0,0,16,16" Background="White" Padding="18" CornerRadius="8"
                                        BoxShadow="0 4 16 0 #14000000" IsVisible="{Binding IsAdmin}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Dirección" FontWeight="Bold" FontSize="16" Foreground="#00723F" />
                                        <TextBlock TextWrapping="Wrap" Text="Asigna tutores a cada materia." />
                                        <Button Classes="cardAction" Content="Gestionar tutores" Command="{Binding GoCommand}" CommandParameter="admin" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <Border IsVisible="{Binding ShowSessions}" Background="White" Padding="24" CornerRadius="8"
                                BoxShadow="0 8 24 0 #14000000">
                            <StackPanel Spacing="12">
                                <TextBlock Text="ASESORÍAS" Foreground="#DD971A" FontWeight="Bold" LetterSpacing="1.2" />
                                <TextBlock Text="Solicitudes del periodo" FontSize="22" FontWeight="SemiBold" Foreground="#024731" />
                                <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="13"
                                           IsVisible="{Binding IsStudent}"
                                           Text="Puedes cancelar una solicitud pendiente. Las confirmadas se mantienen hasta que el programa defina el proceso logístico." />
                                <TextBlock Text="Aún no hay solicitudes en este periodo." Foreground="#777"
                                           IsVisible="{Binding !HasSessions}" />
                                <ListBox Classes="catalog" MaxHeight="360"
                                         ItemsSource="{Binding Sessions}"
                                         SelectedItem="{Binding SelectedSession}"
                                         IsVisible="{Binding HasSessions}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:SessionItem">
                                            <Border Classes="pick">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="#00723F" />
                                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Classes="ghost" Content="Cancelar solicitud pendiente"
                                        Command="{Binding CancelSessionCommand}"
                                        IsVisible="{Binding CanCancelSelected}"
                                        HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsAdvisor}">
                                    <Button Classes="cta" Content="Confirmar" Command="{Binding ConfirmSessionCommand}" />
                                    <Button Classes="ghost" Content="Rechazar" Command="{Binding RejectSessionCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding ShowAdmin}" Background="White" Padding="24" CornerRadius="8"
                                BoxShadow="0 8 24 0 #14000000">
                            <StackPanel Spacing="12">
                                <TextBlock Text="DIRECCIÓN DEL PROGRAMA" Foreground="#DD971A" FontWeight="Bold" LetterSpacing="1.2" />
                                <TextBlock Text="Tutores y materias" FontSize="22" FontWeight="SemiBold" Foreground="#024731" />
                                <ListBox Classes="catalog" MaxHeight="220"
                                         ItemsSource="{Binding AdminAdvisors}"
                                         SelectedItem="{Binding SelectedAdminAdvisor}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AdvisorItem">
                                            <Border Classes="pick">
                                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Background="#F7F4EE" Padding="12" CornerRadius="4">
                                    <ItemsControl ItemsSource="{Binding AdminSubjects}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AssignableSubject">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned}" Margin="8,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Button Classes="cta" Content="Guardar asignación" Command="{Binding SaveAssignmentsCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid IsVisible="{Binding ShowSearch}" Margin="16" RowDefinitions="Auto,*">
                <TextBlock Text="{Binding Status}" Foreground="#024731" FontSize="13" Margin="4,0,4,10" TextWrapping="Wrap" />
                <Border Grid.Row="1" Background="White" CornerRadius="8" BoxShadow="0 8 24 0 #14000000" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Border Background="#024731" Padding="18,14">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Classes="ghost" Content="Volver"
                                        Command="{Binding BackCatalogCommand}"
                                        IsVisible="{Binding ShowCatalogBack}"
                                        Foreground="White" BorderBrush="#FEBE10" Margin="8,0,0,0" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="CATÁLOGO 2026-2" Foreground="#FEBE10" FontSize="12" FontWeight="Bold" LetterSpacing="1.1" />
                                    <TextBlock Text="{Binding CatalogHeading}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CatalogContext}" Foreground="#E7F3EA" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBox Grid.Row="1" Margin="16,12,16,8"
                                 Watermark="Buscar por nombre o clave…"
                                 Text="{Binding SubjectQuery}"
                                 IsVisible="{Binding ShowSubjectStep}" />

                        <Grid Grid.Row="2" Margin="8,0,8,8">
                            <ListBox Classes="catalog"
                                     ItemsSource="{Binding VisibleSubjects}"
                                     SelectedItem="{Binding SelectedSubject}"
                                     IsVisible="{Binding ShowSubjectStep}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:SubjectItem">
                                        <Border Classes="pick">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#024731" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Code}" FontSize="11" Foreground="#777"
                                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No hay materias que coincidan." Foreground="#777" Margin="16"
                                       IsVisible="{Binding EmptySubjects}" />

                            <ListBox Classes="catalog"
                                     ItemsSource="{Binding Advisors}"
                                     SelectedItem="{Binding SelectedAdvisor}"
                                     IsVisible="{Binding ShowAdvisorStep}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdvisorItem">
                                        <Border Classes="pick">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TutorKind}" FontSize="12" FontWeight="Bold" Foreground="#DD971A" />
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#024731" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Area}" FontSize="13" Foreground="#555" TextWrapping="Wrap" />
                                                <TextBlock Foreground="#00723F" FontSize="12"
                                                           Text="{Binding DefaultModality, StringFormat='Modalidad: {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Dirección aún no asignó tutores a esta materia." Foreground="#777" Margin="16"
                                       IsVisible="{Binding EmptyAdvisors}" />

                            <ListBox Classes="catalog"
                                     ItemsSource="{Binding Slots}"
                                     SelectedItem="{Binding SelectedSlot}"
                                     IsVisible="{Binding ShowSlotStep}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AvailabilityItem">
                                        <Border Classes="pick">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <StackPanel Width="110">
                                                    <TextBlock Text="{Binding DayName}" FontWeight="SemiBold" Foreground="#024731" />
                                                    <TextBlock Text="{Binding TimeRange}" FontSize="13" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Modality}" FontSize="13" Foreground="#00723F" />
                                                    <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#777" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Este tutor no tiene bloques de horario publicados." Foreground="#777" Margin="16"
                                       IsVisible="{Binding EmptySlots}" />
                        </Grid>

                        <Border Grid.Row="3" Padding="16" BorderBrush="#E4DDD0" BorderThickness="0,1,0,0"
                                IsVisible="{Binding ShowRequestStep}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Solicitar este horario" FontWeight="SemiBold" Foreground="#024731" />
                                <TextBox Watermark="Tema o duda" Text="{Binding Topic}" />
                                <TextBlock Text="Al enviar te pediremos iniciar sesión con @uabc.edu.mx."
                                           Foreground="#777" FontSize="12" IsVisible="{Binding IsGuest}" />
                                <Button Classes="cta" Content="{Binding RequestButtonText}"
                                        Command="{Binding RequestSessionCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#024731" Padding="16,10">
            <TextBlock Text="Programa de Asesorías Académicas · progasesorias.fcqi@uabc.edu.mx · FCQI · UABC Tijuana"
                       Foreground="#E7F3EA" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
