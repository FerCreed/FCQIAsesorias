<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCQI.Web.ViewModels"
             xmlns:models="using:FCQI.Web.Models"
             xmlns:views="using:FCQI.Web.Views"
             x:Class="FCQI.Web.Views.AvailabilityView"
             x:DataType="vm:AvailabilityViewModel">
    <StackPanel Classes="page">
        <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="Mis horarios" AutomationProperties.HeadingLevel="1" />
            <TextBlock Classes="muted" FontSize="15">
                <Run Text="Bloques semanales del ciclo vigente:" /> <Run Text="{Binding WeeklyHours}" /><Run Text=" horas por semana." />
            </TextBlock>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="8">
                <Border Classes="card" IsVisible="{Binding IsEmpty}">
                    <TextBlock Classes="muted" Text="Aún no publicas horarios. Agrega tu primer bloque con el formulario." />
                </Border>
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AvailabilityItem">
                            <Border Classes="pick">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Data="{StaticResource Icon.Clock}" Foreground="{StaticResource BrushGreen}" Margin="0,2,10,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushGreenDark}">
                                            <Run Text="{Binding DayName}" /> <Run Text="{Binding TimeRange}" />
                                        </TextBlock>
                                        <TextBlock Classes="muted" Text="{Binding Where}" />
                                        <TextBlock Classes="muted" Text="{Binding MaxCapacity, StringFormat='Cupo: {0}'}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="2" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                                        <Button Classes="quiet" Command="{Binding $parent[UserControl].((vm:AvailabilityViewModel)DataContext).EditCommand}"
                                                CommandParameter="{Binding}">
                                            <views:IconText Icon="{StaticResource Icon.Edit}" Text="Editar" />
                                        </Button>
                                        <Button Classes="danger" Command="{Binding $parent[UserControl].((vm:AvailabilityViewModel)DataContext).RetireCommand}"
                                                CommandParameter="{Binding}">
                                            <views:IconText Icon="{StaticResource Icon.Delete}" Text="Retirar" />
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Classes="side" Spacing="14">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="{Binding FormTitle}" />
                        <Label Content="Día" Target="Day" />
                        <ComboBox x:Name="Day" ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" />
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Spacing="6">
                                <Label Content="Inicio" Target="Start" />
                                <TimePicker x:Name="Start" SelectedTime="{Binding Start}" MinuteIncrement="30" ClockIdentifier="24HourClock" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <Label Content="Fin" Target="End" />
                                <TimePicker x:Name="End" SelectedTime="{Binding End}" MinuteIncrement="30" ClockIdentifier="24HourClock" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Cupo por sesión" Target="Capacity" />
                        <NumericUpDown x:Name="Capacity" Value="{Binding Capacity}" Minimum="1" Maximum="30" Increment="1" FormatString="0" />
                        <Label Content="Lugar" Target="Place" />
                        <ComboBox x:Name="Place" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" />
                        <Button Classes="primary" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch">
                            <views:IconText Icon="{StaticResource Icon.Checkmark}" Text="Guardar horario" />
                        </Button>
                        <Button Classes="quiet" Command="{Binding NewCommand}" IsVisible="{Binding IsEditing}" HorizontalAlignment="Stretch">
                            <views:IconText Icon="{StaticResource Icon.Dismiss}" Text="Cancelar edición" />
                        </Button>
                        <TextBlock Classes="muted" FontSize="12"
                                   Text="No se puede mover ni retirar un bloque con citas por venir; cancélalas primero." />
                    </StackPanel>
                </Border>

                <!-- Resumen del asesor: asesorías y horas trabajadas -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="h3" Text="Mi resumen de horas" />
                        <TextBlock Classes="muted" Text="Tus asesorías del periodo y las horas trabajadas (realizadas con asistencia)." />
                        <Label Content="Desde" Target="From" />
                        <CalendarDatePicker x:Name="From" SelectedDate="{Binding SummaryFrom}" SelectedDateFormat="Short" />
                        <Label Content="Hasta" Target="To" />
                        <CalendarDatePicker x:Name="To" SelectedDate="{Binding SummaryTo}" SelectedDateFormat="Short" />
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Classes="primary" Command="{Binding DownloadSummaryCommand}" CommandParameter="pdf">
                                <views:IconText Icon="{StaticResource Icon.Pdf}" Text="PDF" />
                            </Button>
                            <Button Classes="quiet" Command="{Binding DownloadSummaryCommand}" CommandParameter="csv">
                                <views:IconText Icon="{StaticResource Icon.Table}" Text="CSV" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
