<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCQI.Web.ViewModels"
             xmlns:views="using:FCQI.Web.Views"
             x:Class="FCQI.Web.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{StaticResource Paper}">

    <!--
        Diseño adaptable: ShellView.axaml.cs pone la clase "compact" en la raíz
        cuando la app mide menos de 640 px de ancho. Decide el ancho de la
        propia app, no el de la pantalla, así que funciona igual en una ventana
        de escritorio angosta que en un teléfono vertical.
          · ancho:    menú horizontal en la cabecera.
          · compact:  cabecera compacta y pestañas fijas abajo.
        Clases que usan las páginas: .side, .cards, .stretchCompact.
    -->
    <UserControl.Styles>
        <Style Selector="Border.bottomTabs">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UniformGrid.cards">
            <Setter Property="Columns" Value="3" />
        </Style>
        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="24,24,24,32" />
            <Setter Property="MaxWidth" Value="1040" />
            <Setter Property="Spacing" Value="16" />
        </Style>
        <!-- Panel lateral de las páginas con lista + formulario. -->
        <Style Selector="Control.side">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>

        <!-- Pantallas angostas. Van después: a igual selector, gana el último. -->
        <Style Selector="Grid.compact Border.bottomTabs">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Grid.compact ItemsControl.topMenu">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.compact TextBlock.subtitle">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.compact UniformGrid.cards">
            <Setter Property="Columns" Value="1" />
        </Style>
        <Style Selector="Grid.compact StackPanel.page">
            <Setter Property="Margin" Value="14,16,14,24" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style Selector="Grid.compact TextBlock.h1">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="Grid.compact Border.card">
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Grid.compact Control.side">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="Grid.compact Button.stretchCompact">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:LoginViewModel"><views:LoginView /></DataTemplate>
        <DataTemplate DataType="vm:CatalogViewModel"><views:CatalogView /></DataTemplate>
        <DataTemplate DataType="vm:SessionsViewModel"><views:SessionsView /></DataTemplate>
        <DataTemplate DataType="vm:AvailabilityViewModel"><views:AvailabilityView /></DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel"><views:AdminView /></DataTemplate>
        <DataTemplate DataType="vm:ReportsViewModel"><views:ReportsView /></DataTemplate>
    </UserControl.DataTemplates>

    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="{StaticResource GreenDeep}" Padding="20,12,20,0">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="2" Margin="0,0,0,10">
                    <TextBlock Text="Asesorías académicas" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Classes="subtitle" Text="Facultad de Ciencias Químicas e Ingeniería, UABC" Foreground="#B9D7C5" FontSize="12" />
                </StackPanel>

                <!-- Cuenta: rol activo, entrar y salir -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{Binding Session.Roles}" SelectedItem="{Binding Session.ActiveRole}"
                              IsVisible="{Binding Session.HasSeveralRoles}" MinWidth="120"
                              ToolTip.Tip="Rol con el que usas el sistema" />
                    <Button Classes="primary" Content="Entrar" Command="{Binding OpenLoginCommand}"
                            IsVisible="{Binding !Session.IsLoggedIn}" />
                    <Button Classes="quiet" Content="Salir" Command="{Binding LogoutCommand}"
                            Foreground="White" BorderBrush="#7FB89A"
                            IsVisible="{Binding Session.IsLoggedIn}" />
                </StackPanel>

                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" Classes="topMenu" ItemsSource="{Binding Menu}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Button Classes="nav" Classes.current="{Binding IsCurrent}" Content="{Binding Label}"
                                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).GoCommand}"
                                    CommandParameter="{Binding Page}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Resultado de la última acción -->
        <Border Grid.Row="1" Padding="20,10" IsVisible="{Binding Status.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{StaticResource GreenMist}" Classes.error="{Binding Status.IsError}">
            <Border.Styles>
                <Style Selector="Border.error">
                    <Setter Property="Background" Value="#FDECEA" />
                </Style>
            </Border.Styles>
            <TextBlock Text="{Binding Status.Message}" FontSize="13" MaxWidth="1040" HorizontalAlignment="Left" />
        </Border>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding CurrentPage}" />
        </ScrollViewer>

        <!-- Pestañas inferiores en pantallas angostas -->
        <Border Grid.Row="3" Classes="bottomTabs" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <ItemsControl ItemsSource="{Binding Menu}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItem">
                        <Button Classes="tab" Classes.current="{Binding IsCurrent}"
                                Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).GoCommand}"
                                CommandParameter="{Binding Page}">
                            <TextBlock Text="{Binding Label}" TextAlignment="Center" FontSize="12" Foreground="{Binding $parent[Button].Foreground}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
