<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCQI.Web.ViewModels"
             x:Class="FCQI.Web.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <StackPanel Classes="page">
        <Border Classes="card" MaxWidth="460" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="Entrar" />
                <TextBlock Classes="muted"
                           Text="Usa tu cuenta @uabc.edu.mx para solicitar asesorías, atender solicitudes como asesor o entrar como dirección." />

                <TextBlock Classes="label" Text="Correo institucional" />
                <TextBox Text="{Binding Email}" Watermark="nombre.apellido@uabc.edu.mx" />

                <TextBlock Classes="label" Text="Contraseña" />
                <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="Contraseña">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" />

                <Button Classes="primary" Content="Entrar" Command="{Binding SignInCommand}"
                        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />

                <TextBlock Classes="muted" FontSize="12"
                           Text="Mientras se conecta el directorio UABC, no se verifica la contraseña: basta un correo dado de alta en el programa." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
