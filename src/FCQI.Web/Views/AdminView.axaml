<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCQI.Web.ViewModels"
             xmlns:models="using:FCQI.Web.Models"
             x:Class="FCQI.Web.Views.AdminView"
             x:DataType="vm:AdminViewModel">
    <StackPanel Classes="page">
        <StackPanel Spacing="4">
            <TextBlock Classes="h1" Text="Tutores y materias" />
            <TextBlock Classes="muted" FontSize="15" Text="Elige un tutor y marca las materias que cubre este ciclo." />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <ListBox Classes="picker" ItemsSource="{Binding Advisors}" SelectedItem="{Binding SelectedAdvisor}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AdvisorItem">
                        <Border Classes="pick">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="{Binding Summary}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Classes="card side" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Classes="h3" Text="{Binding SelectedAdvisor.FullName, FallbackValue='Elige un tutor'}" />
                    <ItemsControl ItemsSource="{Binding Subjects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AssignableSubject">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="primary" Content="Guardar materias" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
