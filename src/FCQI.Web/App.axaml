<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FCQI.Web.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <Color x:Key="UabcGreen">#00723F</Color>
        <Color x:Key="UabcGreenDark">#024731</Color>
        <Color x:Key="UabcGold">#DD971A</Color>
        <Color x:Key="UabcGoldSoft">#FEBE10</Color>
        <Color x:Key="UabcLime">#50B848</Color>
        <SolidColorBrush x:Key="BrushGreen" Color="#00723F" />
        <SolidColorBrush x:Key="BrushGreenDark" Color="#024731" />
        <SolidColorBrush x:Key="BrushGold" Color="#DD971A" />
        <SolidColorBrush x:Key="BrushGoldSoft" Color="#FEBE10" />
        <SolidColorBrush x:Key="BrushPaper" Color="#F7F4EE" />
        <SolidColorBrush x:Key="BrushInk" Color="#1A1A1A" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#024731" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Foreground" Value="#DD971A" />
            <Setter Property="BorderBrush" Value="#DD971A" />
        </Style>
        <Style Selector="Button.cta">
            <Setter Property="Background" Value="#DD971A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Button.cta:pointerover">
            <Setter Property="Background" Value="#B08208" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#00723F" />
            <Setter Property="BorderBrush" Value="#00723F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4DDD0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FEF4D8" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8D0C4" />
        </Style>
    </Application.Styles>
</Application>
