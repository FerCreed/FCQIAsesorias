<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FCQI.Web.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <Color x:Key="UabcGreen">#00723F</Color>
        <Color x:Key="UabcGreenDark">#024731</Color>
        <Color x:Key="UabcGold">#DD971A</Color>
        <Color x:Key="UabcGoldSoft">#FEBE10</Color>
        <Color x:Key="UabcLime">#50B848</Color>
        <SolidColorBrush x:Key="BrushGreen" Color="#00723F" />
        <SolidColorBrush x:Key="BrushGreenDark" Color="#024731" />
        <SolidColorBrush x:Key="BrushGold" Color="#DD971A" />
        <SolidColorBrush x:Key="BrushGoldSoft" Color="#FEBE10" />
        <SolidColorBrush x:Key="BrushPaper" Color="#F7F4EE" />
        <SolidColorBrush x:Key="BrushInk" Color="#1A1A1A" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#024731" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Foreground" Value="#DD971A" />
            <Setter Property="BorderBrush" Value="#DD971A" />
        </Style>
        <Style Selector="Button.cta">
            <Setter Property="Background" Value="#DD971A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Button.cta:pointerover">
            <Setter Property="Background" Value="#B08208" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#00723F" />
            <Setter Property="BorderBrush" Value="#00723F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4DDD0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="IsScrollInertiaEnabled" Value="True" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#00723F" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#DD971A" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton.LineButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.catalog">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.BringIntoViewOnFocusChange" Value="False" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.catalog ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#FEF4D8" />
        </Style>
        <Style Selector="ListBox.catalog ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.pick">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4DDD0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="ListBox.catalog ListBoxItem:selected Border.pick">
            <Setter Property="BorderBrush" Value="#DD971A" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#FFF8E8" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8D0C4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="Button.cardAction">
            <Setter Property="Background" Value="#00723F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Application.Styles>
</Application>
