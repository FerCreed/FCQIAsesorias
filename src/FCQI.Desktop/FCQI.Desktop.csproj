<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cabecera de escritorio (Windows, macOS, Linux) del mismo cliente Avalonia
       que corre en el navegador. Toda la interfaz vive en FCQI.Web. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FCQI.Asesorias</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FCQI.Web\FCQI.Web.csproj" />
  </ItemGroup>

</Project>
